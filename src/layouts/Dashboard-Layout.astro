              <!-- ------------------------------------------------------------------------------------------------------------------------------------- -->
              <!-- ------------------------------------------------------------------------------------------------------------------------------------- -->
        
            </main>
            <div id="modal-root"></div>
          </body>
        </html>
        
<script>
//@ts-nocheck
import { jwtDecode } from 'jwt-decode'
const inputsAdmin = document.querySelectorAll('.admin')
console.log(inputsAdmin)

interface Payload {
  ocupacion: string
  correo: string
  nombre: string
  apellido: string
  id: number
  iat: number
  exp: number
}

let payload = {}
const token = localStorage.getItem('token')

addEventListener('DOMContentLoaded',()=>{
  autentificar()
  cargarDatos()
})

async function cargarDatos(){
  await cambiarFoto()
  try {
      const res = await fetch(`http://localhost:4000/api/personal/${payload.id}`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        }
      })

      const data = await res.json()

      if (!res.ok) {
        console.error('Error al obtener datos del profesor:', data)
        return null
      }
        const username = document.getElementById('username')
        username.textContent = `${data.body[0].nombre} ${data.body[0].apellido}`
      
    } catch (error) {
      console.error('Error de red:', error)
      return null
    }
}

function autentificar(){
  if (typeof window !== 'undefined') {

    if (!token) {
      window.location.href = '/'
    } else {
      try {
        payload = jwtDecode<Payload>(token)
        // Verifica ocupacion
        const ocupacion = payload.ocupacion ? payload.ocupacion.toLowerCase() : ''

        if (!['administrador', 'profesor'].includes(ocupacion)) {
          window.location.href = '/no-autorizado'
        }
        if(!['administrador'].includes(ocupacion)){
          inputsAdmin.forEach(input => input.classList.add("hidden"))
        }

      } catch (e) {
        window.location.href = '/'
      }
    }
  }
}

  //Funcionalidad del focus sobre los items del side menu
  (function focusNavbar(){
    const currentPage : string = window.location.pathname.split("/").pop() ?? ""
    focus(currentPage)
  }
  )()

  function focus(currentPath: string){
    const arrayUrls = ['inicio-dashboard','correccion-practicos','cargar-examenes','cargar-notas-cursado','desempeno-estudiantil','informacion-cursos','gestionar-cursos','gestionar-aulas-y-horarios','gestionar-usuarios','estudiantes-inscriptos','titulacion']
    
    arrayUrls.forEach(url =>{
      if(url == currentPath){
        document.querySelector('#'+url)?.classList.add("bg-blue-500/13","font-semibold","text-slate-700")
        }
      })
    }

  // Funcionalidad del menu para esconderse y mostrarse en resoluciones menores
  const navbar = document.querySelector(".-translate-x-full")
  
  document.querySelector("#display-menu")?.addEventListener("click",()=>{
    if(navbar?.classList.contains("-translate-x-full")){
      navbar?.classList.add("+translate-x-full")
      navbar?.classList.remove("-translate-x-full")
    }
    else{
      navbar?.classList.remove("+translate-x-full")
      navbar?.classList.add("-translate-x-full")
    }
  })

  //Mostrar el contenido cuando termina de cargar el contenido
  document.addEventListener("DOMContentLoaded", function() {
  document.body.style.visibility = "visible";
  });

  	//MENU DESPLEGABLE
	const  drop = document.querySelector("#dropdownButton")
	const dropmenu = document.querySelector("#dropdownContent")
	drop?.addEventListener("click",()=>{
		if(dropmenu?.classList.contains("hidden")){
			dropmenu?.classList.remove("hidden")
		}
		else{
			dropmenu?.classList.add("hidden")
		}
		})

		document.addEventListener("click", (e) => {
		// Si el menú está abierto y el click no fue dentro del menú ni del botón
		if (!dropmenu?.classList.contains("hidden") && !dropmenu.contains(e.target) && !drop.contains(e.target)) {
			dropmenu.classList.add("hidden")
		}
		})
  
  document.getElementById('cerrarSesion').addEventListener('click',()=>{
    localStorage.removeItem('token')
    window.location.href = '/'
  })

  	async function cambiarFoto(){
		try {
			const res = await fetch(`http://localhost:4000/api/personal/${payload.id}`, {
			method: 'GET',
			headers: {
				'Content-Type': 'application/json',
				'Authorization': `Bearer ${token}`
			}
			})

			const data = await res.json()

			if (!res.ok) {
			console.error('Error al obtener la imagne de perfil', data)
			return null
			}

			if(data.body[0].imagen !== null){
				document.getElementById('perfil-menu').src = 'http://localhost:4000/' + data.body[0].imagen
			}

		} catch (error) {
			console.error('Error de red:', error)
			return null
		}
	}
</script>


<style>
body{
  font-family: 'Lato', sans-serif;
}
