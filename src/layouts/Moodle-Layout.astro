---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../css/style.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="../../public/img/favicon.png">
	    <link href='https://fonts.googleapis.com/css?family=Lato:400,700' rel='stylesheet' type='text/css'>
		<script src="https://kit.fontawesome.com/aef010b255.js" crossorigin="anonymous"></script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="flex justify-center bg-gradient-to-br from-blue-100 via-sky-100 to-white min-h-screen">
		<div class="w-full max-w-7xl">
			<nav class="bg-white border-b shadow-sm flex flex-wrap items-center justify-between" navbar-main navbar-scroll="false">   
				<div class="flex items-center justify-between w-full px-4 py-1 mx-auto flex-wrap-inherit">
					<a href="/inicio" class="flex items-center">
					<div>
						<img src="../../public/img/school-icon.png" alt="school icon" class="w-10 ml-5">
					</div>
					<span class="ml-5 font-bold">Aula virtual EFP N°31</span>
					</a>
					<!--left options -->
					<div class="flex items-center mt-2 grow sm:mt-0 sm:mr-6 md:mr-0 lg:flex lg:basis-auto">
						<ul class="md:ml-auto md:pr-4 flex flex-row justify-end pl-0 mb-0 list-none md-max:w-full">
							<li id="dashboard" class="flex items-center hidden">
							</li>
							<li class="flex items-center">
							<div id="dropdownButton" class="py-1 px-2 flex relative rounded-full text-white ml-10 bg-slate-900 hover:bg-slate-700 transition">
								<button id="username" class="ml-2 mr-3"></button>
								<div id="dropdownContent" class="dropdown-content hidden absolute bg-white w-full shadow-lg rounded-xl border-2 left-0 top-14 z-10 text-black">
									<a href="/perfil-alumno" id="ir-al-perfil" class="hover:rounded-t-lg">Perfil</a>
									<a href="/inicio-dashboard" class="hover:rounded-lg">ir al Dashboard</a>
									<a href="/" id="cerrarSesion" class="hover:rounded-b-lg">cerrar sesión</a>
								</div>
								<div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center bg-gray-200">
									<img id="perfil-menu" src="../../public/img/avatar-femenino.png" alt="" class="object-cover w-full h-full">
								</div>
							</div>
							</li>
						</ul>
						<!-- FIN Sign in Menu(flex) config notificacion box -->
					</div>
				</div>
			</nav>
			<div class="flex justify-center bg-gradient-to-b from-gray-200 to-white min-h-screen">
				<div class="w-full max-w-[1200px] flex flex-col items-center px-4 py-8 space-y-6">

					<!-- Slot u otros componentes -->
					<slot />

				</div>
			</div>
		</div>
	</body>
</html>

<script>
	//@ts-nocheck
	import { jwtDecode } from 'jwt-decode'
	let token = {}
	let payload = {}
	function obtenerPayload(){
		interface Payload {
			tipo: string
			correo: string
			nombre: string
			apellido: string
			id: number
			iat: number
			exp: number
			rol?: string
		}

		if (typeof window !== 'undefined') {
			token = localStorage.getItem('token')

			if (!token) {
			window.location.href = '/error'
			} else {
				try {
					payload = jwtDecode<Payload>(token)

					if (!['profesor', 'administrador', 'alumno'].includes(payload.ocupacion.toLowerCase())) {
						window.location.href = '/error'
					}
					if(['profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())){
						document.getElementById('dashboard')?.classList.remove('hidden')
						const perfil = document.getElementById('ir-al-perfil')
						console.log(perfil)
						perfil.href ='/perfil'
					}
					return [token,payload]
				} catch (e) {
					window.location.href = '/'
				}
			}
		}
	}

	addEventListener('DOMContentLoaded',()=>{
		[token,payload] = obtenerPayload()
		cargarDatos()
	})

	async function cargarDatos(){
		await cambiarFoto()
		if (['profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())){
			try {
				const res = await fetch(`http://localhost:4000/api/personal/${payload.id}`, {
					method: 'GET',
					headers: {
					'Content-Type': 'application/json',
					'Authorization': `Bearer ${token}`
					}
				})

				const data = await res.json()

				if (!res.ok) {
					console.error('Error al obtener datos del profesor:', data)
					return null
				}
					const username = document.getElementById('username')
					username.textContent = `${data.body[0].nombre} ${data.body[0].apellido}`
				
			} catch (error) {
				console.error('Error de red:', error)
				return null
			}
		}
		else{
			try {
				const res = await fetch(`http://localhost:4000/api/alumno/${payload.id}`, {
					method: 'GET',
					headers: {
					'Content-Type': 'application/json',
					'Authorization': `Bearer ${token}`
					}
				})

				const data = await res.json()

				if (!res.ok) {
					console.error('Error al obtener datos del profesor:', data)
					return null
				}
					const username = document.getElementById('username')
					username.textContent = `${data.body[0].nombre} ${data.body[0].apellido}`
				
			} catch (error) {
				console.error('Error de red:', error)
				return null
			}
		}
		
	}

	async function cambiarFoto(){
		if(['profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())){
			try {
				const res = await fetch(`http://localhost:4000/api/personal/${payload.id}`, {
				method: 'GET',
				headers: {
					'Content-Type': 'application/json',
					'Authorization': `Bearer ${token}`
				}
				})

				const data = await res.json()

				if (!res.ok) {
				console.error('Error al obtener la imagne de perfil', data)
				return null
				}

				if(data.body[0].imagen !== null){
					document.getElementById('perfil-menu').src = 'http://localhost:4000/' + data.body[0].imagen
				}

			} catch (error) {
				console.error('Error de red:', error)
				return null
			}
		}else{
			try {
				const res = await fetch(`http://localhost:4000/api/alumno/${payload.id}`, {
				method: 'GET',
				headers: {
					'Content-Type': 'application/json',
					'Authorization': `Bearer ${token}`
				}
				})

				const data = await res.json()

				if (!res.ok) {
				console.error('Error al obtener alumno:', data)
				return null
				}

				if(data.body[0].imagen !== null){
					document.getElementById('perfil-menu').src = 'http://localhost:4000/' + data.body[0].imagen
				}

			} catch (error) {
				console.error('Error de red:', error)
				return null
			}
		}
		
	}
	


	//MENU DESPLEGABLE
	const  drop = document.querySelector("#dropdownButton")
	const dropmenu = document.querySelector("#dropdownContent")
	drop?.addEventListener("click",()=>{
		if(dropmenu?.classList.contains("hidden")){
			dropmenu?.classList.remove("hidden")
		}
		else{
			dropmenu?.classList.add("hidden")
		}
		})

		document.addEventListener("click", (e) => {
		// Si el menú está abierto y el click no fue dentro del menú ni del botón
		if (!dropmenu?.classList.contains("hidden") && !dropmenu.contains(e.target) && !drop.contains(e.target)) {
			dropmenu.classList.add("hidden")
		}
	})

document.getElementById('cerrarSesion').addEventListener('click',()=>{
	localStorage.removeItem('token')
	window.location.href = '/'
})
</script>

<style>
	.dropdown-content a {
	  color: black;
	  padding: 12px 16px;
	  text-decoration: none;
	  display: block;
	}
	
	.dropdown-content a:hover {
	  background-color: #ddd;
	}
	</style>