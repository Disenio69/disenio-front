---
import MoodleLayout from "../../layouts/Moodle-Layout.astro"
---

<MoodleLayout title='titulo'>
  <div class="w-full bg-white shadow-md rounded-xl p-6 text-center">
    <h1 id="titulo" class="text-2xl font-semibold text-gray-800"></h1>
  </div>

  <section id="mainContainer" class="w-full bg-white rounded-xl shadow p-6 space-y-8">
    <select class="appearance-none block bg-gray-300 text-white rounded-xl py-3 px-4 mb-3 leading-tight focus:outline-none hidden" id="add-element" name="add-element">
      <option value="" disabled selected>-- Agregar elemento --</option>
      <option value="section">Sección</option>
      <option value="link">Link (archivo)</option>
      <option value="entrega">Entrega de trabajos</option>
    </select>

    <a href="/inicio" class="flex items-center text-black hover:underline">
      <span class="mr-1">←</span> Volver al inicio
    </a>

    <div id="content"></div>
  </section>
</MoodleLayout>

<script>
//@ts-nocheck
const token = localStorage.getItem('token')
let secciones = []
let elementos = []
let contenidos = ''
let json = { id: '', json_html: '' }
let permisoEdicion = false
let payload = null
let entregas = []

addEventListener('DOMContentLoaded', async () => {

  const url = window.location.href
  const parts = url.split("/")
  const id = parts[parts.length - 1]

  json.id = id
  await obtenerTitulo();
  [permisoEdicion, payload] = await verificarIdentidad()
  await actualizarContenidos(id, permisoEdicion,payload)
  initSelect()

  

})

async function obtenerTitulo() {
  const resCurso = await fetch(`http://localhost:4000/api/curso/${json.id}`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    }
  })
  if (!resCurso.ok) {
    console.error('Error al obtener informacion del curso')
    return
  }
  const dataCurso = await resCurso.json()
  const titulo = document.getElementById('titulo')
  titulo.innerHTML = `${dataCurso.body[0].nombre}`
}

async function verificarIdentidad() {
  payload = await verificarOcupacion()
  permisoEdicion = await VerificarPermisoAccessoAlCurso(payload)
  return [permisoEdicion, payload]
}

async function VerificarPermisoAccessoAlCurso() {
  let permisoAcceso = false

  const resProf = await fetch(`http://localhost:4000/api/curso/${json.id}/profesores`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    }
  })
  if (!resProf.ok) {
    console.error('Error al obtener profesores asignados al curso')
    return
  }
  const dataProf = await resProf.json()

  const resAlumno = await fetch(`http://localhost:4000/api/curso/${json.id}/alumnos-simples`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    }
  })
  if (!resAlumno.ok) {
    console.error('Error al obtener alumnos asignados al curso')
    return
  }
  const dataAlumno = await resAlumno.json()

  dataProf.body.forEach(prof => {
    if (prof.id === payload.id) {
      permisoAcceso = true
      permisoEdicion = true
      return
    }
  })

  dataAlumno.body.forEach(alumno => {
    if (alumno.id === payload.id) {
      permisoAcceso = true
      return
    }
  })

  if (!permisoAcceso) {
    window.location.href = '/inicio'
  }

  return permisoEdicion
}

async function verificarOcupacion() {
  const base64Url = token.split('.')[1]
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(function (c) {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
  }).join(''))
  const payload = JSON.parse(jsonPayload)
  if (!['alumno', 'profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())) {
    window.location.href = '/inicio'
  }
  return payload
}

async function actualizarContenidos(id, permisoEdicion) {
  await obtenerHTML(id)
  renderDesdeElementos(permisoEdicion)
}

async function obtenerHTML(id) {
  const res = await fetch(`http://localhost:4000/api/curso_html/curso/${id}`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    }
  })

  if (!res.ok) {
    console.error('Error al obtener HTML')
    return
  }

  const data = await res.json()
  json = { id: data.body.id, json_html: data.body.json_html }

  const tempContainer = document.createElement('div')
  tempContainer.innerHTML = data.body.json_html

  secciones = Array.from(tempContainer.querySelectorAll('.seccion'))
  elementos = []

  secciones.forEach((seccion, index) => {
    const links = seccion.querySelectorAll('a')
    links.forEach(link => {
      if (link.dataset.type === 'entrega') {
        elementos.push({ seccionId: index, type: 'entrega', text: link.innerText, link: null, archivo: null })
      } else {
        elementos.push({ seccionId: index, type: 'link', text: link.innerText, link: link.href })
      }
    })
  })
}

async function guardarHTML() {
  await fetch("http://localhost:4000/api/curso_html/guardar", {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    },
    body: JSON.stringify(json)
  })
}

function actualizarJson(contenidos) {
  json.json_html = contenidos
  guardarHTML()
}

function renderDesdeElementos(permiso = false) {
  const contentDiv = document.getElementById('content')
  contentDiv.innerHTML = ''
  contenidos = ''

  secciones.forEach((seccion, index) => {
    const nuevaSeccion = seccion.cloneNode(true)
    nuevaSeccion.classList.add('bg-white', 'rounded-xl', 'shadow-md', 'p-6', 'mb-6', 'transition', 'hover:shadow-lg')
    const contenedorLinks = nuevaSeccion.querySelector('.contenedor-links')
    if (!contenedorLinks) return
    contenedorLinks.innerHTML = ''

    elementos.forEach((elemento, Index) => {
      if (elemento.type === 'link' && index === elemento.seccionId) {
        const spanElement = crearElementoLink(elemento, Index, permiso)
        contenedorLinks.appendChild(spanElement)
      }

      if (elemento.type === 'entrega' && index === elemento.seccionId) {
        const spanElement = crearElementoEntrega(elemento, Index, permiso)
        contenedorLinks.appendChild(spanElement)
      }
    })

    const h2 = nuevaSeccion.querySelector('h2')
    if (h2) {
      const botonesPrevios = h2.querySelectorAll('button')
      botonesPrevios.forEach(btn => btn.remove())
    }

    const deleteSectionBtn = document.createElement('button')
    deleteSectionBtn.classList.add('ml-2', 'text-red-600', 'font-bold')
    if (!permisoEdicion) {
      deleteSectionBtn.classList.add('hidden')
    }
    deleteSectionBtn.innerText = 'X'
    deleteSectionBtn.addEventListener('click', () => {
      mostrarModalConfirmacion(() => {
        secciones.splice(index, 1)
        elementos = elementos.filter(e => e.seccionId !== index)
        renderDesdeElementos()
      }, '¿Seguro que querés eliminar esta sección y sus elementos?')
    })
    h2?.appendChild(deleteSectionBtn)

    contentDiv.appendChild(nuevaSeccion)
  })

  contenidos = contentDiv.innerHTML
  actualizarJson(contenidos)
}

function crearElementoLink(elemento, index, permiso) {
  const spanElement = document.createElement('span')
  spanElement.classList.add('ml-6', 'flex', 'items-center', 'gap-2', 'mb-2', 'bg-white', 'p-2', 'rounded', 'hover:bg-gray-50', 'transition')

  const icon = document.createElement('i')
  icon.className = 'fa-solid fa-file-arrow-down text-gray-500'
  spanElement.appendChild(icon)

  const linkHTML = document.createElement('a')
  linkHTML.href = elemento.link
  linkHTML.innerText = elemento.text
  linkHTML.target = '_blank'
  linkHTML.classList.add('text-blue-600', 'hover:underline', 'truncate', 'max-w-xs')
  spanElement.appendChild(linkHTML)

  const deleteButton = document.createElement('button')
  deleteButton.classList.add('ml-2', 'text-red-500', 'hover:text-red-700', 'transition')
  if (!permisoEdicion) {
    deleteButton.classList.add('hidden')
  }
  deleteButton.innerText = '×'
  deleteButton.addEventListener('click', () => {
    mostrarModalConfirmacion(() => {
      elementos.splice(index, 1)
      renderDesdeElementos()
    }, '¿Seguro que querés eliminar este enlace?')
  })
  spanElement.appendChild(deleteButton)

  return spanElement
}

function crearElementoEntrega(elemento, index, permiso) {
  const spanElement = document.createElement('span')
  spanElement.classList.add('ml-6', 'flex', 'items-center', 'gap-2', 'mb-2', 'bg-white', 'p-2', 'rounded', 'hover:bg-gray-50', 'transition', 'cursor-pointer')

  const icon = document.createElement('i')
  icon.className = 'fa-solid fa-folder-open text-yellow-500'
  spanElement.appendChild(icon)

  const entregaHTML = document.createElement('a')
  entregaHTML.innerText = elemento.text
  entregaHTML.href = 'javascript:void(0)'
  entregaHTML.classList.add('text-gray-800', 'hover:underline', 'truncate', 'max-w-xs')
  entregaHTML.dataset.type = 'entrega'
  spanElement.appendChild(entregaHTML)

  spanElement.addEventListener('click', () => {
    mostrarModalCargarArchivo(elemento)
  })

  const deleteButton = document.createElement('button')
  deleteButton.classList.add('ml-2', 'text-red-500', 'hover:text-red-700', 'transition')
  if (!permisoEdicion) {
    deleteButton.classList.add('hidden')
  }
  deleteButton.innerText = '×'
  deleteButton.addEventListener('click', (e) => {
    e.stopPropagation()
    mostrarModalConfirmacion(() => {
      elementos.splice(index, 1)
      renderDesdeElementos()
    }, '¿Seguro que querés eliminar esta entrega?')
  })
  spanElement.appendChild(deleteButton)

  return spanElement
}


async function mostrarModalCargarArchivo(elemento) {
  const div = document.createElement('DIV')
  let entregado = false
  const resArchivoEnviado = await fetch(`http://localhost:4000/api/material`, {
    method: 'GET',
    headers: { 'Authorization': `Bearer ${token}` }
  })
  const jsonArcEnv = await resArchivoEnviado.json()
  const dataArcEnv = jsonArcEnv.body
  let mostrarInformacion = {}
  dataArcEnv.forEach(data => {
    if(data.carpeta === elemento.text && data.alumno_id === payload.id)
    entregado = true
    mostrarInformacion = {'archivo': data.observacion, 'estado' : data.estado , 'nota' : data.calificacion , 'carpeta' : data.carpeta}
  });

div.innerHTML = `
  <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white p-8 rounded-2xl w-full max-w-lg shadow-2xl space-y-4 relative">
      <h2 class="text-2xl font-bold text-gray-800">Entregar trabajo</h2>
      <div class="flex items-center space-x-4 ${entregado ? 'hidden' : ''}">
        <input type="file" id="archivo" accept=".pdf,.doc,.docx" 
          class="block w-full rounded-lg border border-gray-300 bg-blue-600 text-white file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-white file:text-blue-600 hover:file:bg-gray-100 transition" >
      </div>
      <p id="archivoNombre" class="text-gray-600"><strong>Archivo:</strong> ${entregado ? mostrarInformacion.archivo : 'Ninguno'}</p>
      <p id="archivoEstado" class="text-gray-600"><strong>Estado:</strong> ${entregado ? mostrarInformacion.estado : 'No enviado'}</p>
      <p id="archivoNota" class="text-gray-600"><strong>Nota:</strong> ${entregado ? mostrarInformacion.nota : '----'}</p>
      <div class="flex justify-end gap-2">
        <button id="guardarArchivoEntrega" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition ${entregado ? 'hidden' : ''}">Enviar Entrega</button>
        <button id="cancelarModal" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 transition">Cancelar</button>
      </div>
    </div>
  </div>
`



  document.body.appendChild(div)

  document.getElementById('cancelarModal').addEventListener('click', () => div.remove())

  document.getElementById('guardarArchivoEntrega').addEventListener('click', async () => {
    const cursoId = json.id
    const archivo = document.getElementById('archivo').files[0]
    const seccionIndex = elemento.seccionId

    if (!archivo) {
      alert('Seleccioná un archivo.')
      return
    }

    const formData = new FormData()
    formData.append('archivo', archivo)
    formData.append('observacion', archivo.name)
    formData.append('carpeta', elemento.text)
    formData.append('curso_id', cursoId)
    formData.append('alumno_id', payload.id)
    formData.append('estado', 'enviado')

    const response = await fetch('http://localhost:4000/api/material/entrega', {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}` },
      body: formData
    })

    if (response.ok) {
      // Actualizar <p> con info
      document.getElementById('archivoNombre').innerHTML = `<strong>Archivo:</strong> ${archivo.name}`
      document.getElementById('archivoEstado').innerHTML = `<strong>Estado:</strong> enviado`
      document.getElementById('archivoNota').innerHTML = `Nota: ----`
      entregas.push({'archivo' : archivo.name, 'estado': 'enviado', 'nota' : '0.00'})

      // Podés dejar el modal abierto o cerrarlo después de unos segundos
      setTimeout(() => {
        div.remove()
        renderDesdeElementos()
      }, 1500)
    } else {
      alert('Error al guardar el archivo.')
    }
  })
}


function initSelect() {
  const select = document.getElementById('add-element')
  if (!select) return

  if (permisoEdicion) {
    select.classList.remove('hidden')
  }

  select.onchange = () => {
    const value = select.value
    if (value === 'section') mostrarModalSeccion()
    if (value === 'link') mostrarModalLinkConArchivo()
    if (value === 'entrega') mostrarModalEntrega()
  }
}

function mostrarModalConfirmacion(callback, mensaje) {
  const div = document.createElement('DIV')
  div.innerHTML = `
    <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <button id='closeModal' class="absolute top-2 right-3 text-gray-500 hover:text-black text-lg">&times;</button>
        <h2 class="text-xl font-semibold text-gray-800">${mensaje}</h2>
        <div class="flex justify-end gap-4">
          <button id="cancel" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Cancelar</button>
          <button id="confirm" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Eliminar</button>
        </div>
      </div>
    </div>
  `
  document.body.appendChild(div)

  document.getElementById('closeModal').addEventListener('click', () => div.remove())
  document.getElementById('cancel').addEventListener('click', () => div.remove())
  document.getElementById('confirm').addEventListener('click', () => {
    callback()
    div.remove()
  })
}

function mostrarModalSeccion() {
  const div = document.createElement('DIV')
  div.innerHTML = `
    <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <button id='closeModal' class="absolute top-2 right-3 text-gray-500 hover:text-black text-lg">&times;</button>
        <h2 class="text-xl font-semibold text-gray-800">Crear nueva sección</h2>
        <input id="new-section" class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" type="text" placeholder="Nombre de la sección">
        <button id="create-section" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Crear sección</button>
      </div>
    </div>
  `
  document.body.appendChild(div)

  document.getElementById('closeModal').addEventListener('click', () => {
    div.remove()
    document.getElementById('add-element').value = ''
  })

  document.getElementById('create-section').addEventListener('click', () => {
    const value = document.getElementById('new-section').value.trim()
    if (!value) return

    const newSection = document.createElement('div')
    newSection.classList.add('seccion', 'p-4', 'border', 'rounded-xl', 'shadow-md')
    newSection.innerHTML = `<h2 class="text-lg font-semibold mb-2">${value}</h2><div class="contenedor-links"></div>`
    secciones.push(newSection)
    renderDesdeElementos(payload)
    div.remove()
    document.getElementById('add-element').value = ''
  })
}

function mostrarModalLinkConArchivo() {
  const div = document.createElement('DIV')
  let options = '<option value="" disabled selected>-- Seleccionar sección --</option>'
  secciones.forEach((sec, index) => {
    const h2 = sec.querySelector('h2')
    let titulo = ''

    if (h2) {
      for (const node of h2.childNodes) {
        if (node.nodeType === Node.TEXT_NODE) {
          titulo = node.textContent.trim()
          break
        }
      }
    }

    if (!titulo) {
      titulo = `Sección ${index}`
    }

    options += `<option value="${index}">${titulo}</option>`
  })

  div.innerHTML = `
    <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <button id='closeModal' class="absolute top-2 right-3 text-gray-500 hover:text-black text-lg">&times;</button>
        <h2 class="text-xl font-semibold text-gray-800">Cargar archivo</h2>
        <select id="seccion" class="appearance-none block w-full bg-gray-300 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none">${options}</select>
        <input type="file" id="archivo" class="block w-full text-sm text-gray-700">
        <button id="guardarArchivo" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Guardar archivo</button>
      </div>
    </div>
  `
  document.body.appendChild(div)

  document.getElementById('closeModal').addEventListener('click', () => {
    div.remove()
    document.getElementById('add-element').value = ''
  })

document.getElementById('guardarArchivo').addEventListener('click', async () => {
  const cursoId = json.id
  const archivo = document.getElementById('archivo').files[0]
  const seccionIndex = parseInt(document.getElementById('seccion').value)

  if (!archivo || isNaN(seccionIndex)) {
    alert('Faltan datos.')
    return
  }

  const formData = new FormData()
  formData.append('archivo', archivo)
  formData.append('curso_id', cursoId)
  formData.append('observacion', archivo.name)

  const response = await fetch('http://localhost:4000/api/material', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${token}` },
    body: formData
  })

  if (response.ok) {
    const data = await response.json()
    const fileId = data.body.id
    const downloadLink = `http://localhost:4000/api/material/descargar/${fileId}`

    elementos.push({ seccionId: seccionIndex, type: 'link', text: archivo.name, link: downloadLink })
    renderDesdeElementos()
    div.remove()
    document.getElementById('add-element').value = ''
  } else {
    alert('Error al guardar el archivo.')
  }
})
}

function mostrarModalEntrega() {
  const div = document.createElement('DIV')
  let options = '<option value="" disabled selected>-- Seleccionar sección --</option>'
  secciones.forEach((sec, index) => {
    const h2 = sec.querySelector('h2')
    let titulo = ''

    if (h2) {
      for (const node of h2.childNodes) {
        if (node.nodeType === Node.TEXT_NODE) {
          titulo = node.textContent.trim()
          break
        }
      }
    }

    if (!titulo) {
      titulo = `Sección ${index}`
    }

    options += `<option value="${index}">${titulo}</option>`
  })

  div.innerHTML = `
    <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <button id='closeModal' class="absolute top-2 right-3 text-gray-500 hover:text-black text-lg">&times;</button>
        <h2 class="text-xl font-semibold text-gray-800">Crear entrega de trabajo</h2>
        <select id="seccionEntrega" class="appearance-none block w-full bg-gray-300 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none">${options}</select>
        <input id="nombreEntrega" class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" type="text" placeholder="Nombre de la entrega">
        <button id="crearEntrega" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Agregar entrega</button>
      </div>
    </div>
  `
  document.body.appendChild(div)

  document.getElementById('closeModal').addEventListener('click', () => {
    div.remove()
    document.getElementById('add-element').value = ''
  })
  
  document.getElementById('crearEntrega').addEventListener('click', () => {
    const nombreEntrega = document.getElementById('nombreEntrega').value.trim()
    const seccionIndex = parseInt(document.getElementById('seccionEntrega').value)

    if (!nombreEntrega || isNaN(seccionIndex)) {
      alert('Faltan datos.')
      return
    }

    elementos.push({ seccionId: seccionIndex, type: 'entrega', text: nombreEntrega, archivo: null , link : null})
    renderDesdeElementos()
    div.remove()
    document.getElementById('add-element').value = ''
  })
}
</script>
