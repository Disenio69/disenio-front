---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title='Cargar un nuevo usuario' path='Agregar nuevo usuario' pageTitle='Agregar nuevo usuario'>
    <form id="form-user-add" class="w-full pl-16 pr-16 mt-6">
      <div class="flex flex-wrap mx-3 mb-6">
          
          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-firshName">
              Nombre
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-firstName" type="text" placeholder="Jane">
          </div>
          
          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-lastName">
              Apellido
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-lastName" type="text" placeholder="Doe">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-birthday">
              Fecha de nacimiento
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-birthday" type="date" onkeydown="return false;" placeholder="Jane">
          </div>
          
          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-dni">
              DNI
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-dni" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-password">
              Contraseña
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-password" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input-student hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-nationality">
              Nacionalidad
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-nationality" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-email">
              Correo Electronico
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-email" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-phone">
              Telefono
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-phone" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input-student hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-residence">
              Domicilio
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-residence" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input-student hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-studyLevel">
              Nivel de estudio
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-studyLevel" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">
              Ocupacion
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-occupation" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-social">
              Estado civil
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-social" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input-student hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-disability">
              Discapacidad
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-disability" type="text" placeholder="Jane">
          </div>

          <div class="w-full md:w-1/3 px-3 mb-6 input-student hidden">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-socialProgram">
              Programa social
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-socialProgram" type="text" placeholder="Jane">
          </div>

        </div>
        <div class="flex items-center ml-6">
            <button id="form-submit" class="bg-gray-500 text-white font-bold py-2 px-4 rounded " type="submit">
              Agregar usuario
            </button>
            <a class="bg-white text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer ml-20" href="/gestion-de-usuarios">
                Cancelar
              </a>
          </div>
      </form>
</DashboardLayout>

<script>
import { Notification } from "../components/notifications.js"

let isStudent = false;
let currentId: number | null = null;
const token = localStorage.getItem('token')

const btnSubmit = document.querySelector("#form-submit") as HTMLButtonElement;
btnSubmit.disabled = true;

document.addEventListener("DOMContentLoaded", () => {
  const form = document.querySelector("#form-user-add") as HTMLFormElement;
  const params = new URLSearchParams(window.location.search);
  const idParam = params.get("id");
  const tipoParam = params.get("tipo"); // "alumno" o "personal"

  const inputsAll = document.querySelectorAll('.input') as NodeListOf<HTMLElement>;
  const inputsEst = document.querySelectorAll('.input-student') as NodeListOf<HTMLElement>;

  const name = document.querySelector("#input-firstName") as HTMLInputElement;
  const lastName = document.querySelector("#input-lastName") as HTMLInputElement;
  const birthDay = document.querySelector("#input-birthday") as HTMLInputElement;
  const dni = document.querySelector("#input-dni") as HTMLInputElement;
  const password = document.querySelector("#input-password") as HTMLInputElement;
  const email = document.querySelector("#input-email") as HTMLInputElement;
  const phone = document.querySelector("#input-phone") as HTMLInputElement;
  const occupation = document.querySelector("#input-occupation") as HTMLInputElement;
  const nationality = document.querySelector("#input-nationality") as HTMLInputElement;
  const residence = document.querySelector("#input-residence") as HTMLInputElement;
  const studyLevel = document.querySelector("#input-studyLevel") as HTMLInputElement;
  const disability = document.querySelector("#input-disability") as HTMLInputElement;
  const socialProgram = document.querySelector("#input-socialProgram") as HTMLInputElement;
  const estadoCivil = document.querySelector("#input-social") as HTMLInputElement;

  function showInputs(isAlumno: boolean) {
    inputsAll.forEach(input => input.classList.remove("hidden"));
    if (isAlumno) {
      inputsEst.forEach(input => input.classList.remove("hidden"));
    } else {
      inputsEst.forEach(input => input.classList.add("hidden"));
    }
    btnSubmit.disabled = false;
    btnSubmit.classList.remove("bg-gray-500");
    btnSubmit.classList.add("bg-blue-500");
    btnSubmit.textContent = "Guardar cambios";
  }

  // Validar que se pasaron los dos parámetros por URL
  if (idParam && tipoParam) {
    currentId = Number(idParam);
    isStudent = tipoParam === "alumno";

    const endpoint = `http://localhost:4000/api/${tipoParam}/${idParam}`;
    
    fetch(endpoint, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })
    .then(res => res.json())
    .then(data => {
        const usuario = (data.body ?? [])[0];
        if (!usuario) {
        alert("No se encontró el usuario.");
        return;
        }

        showInputs(isStudent);

        name.value = usuario.nombre ?? "";
        lastName.value = usuario.apellido ?? "";
        birthDay.value = usuario.fecha_nacimiento?.split("T")[0] ?? "";
        dni.value = usuario.dni ?? "";
        password.value = usuario.contrasena ?? "";
        email.value = usuario.correo ?? "";
        phone.value = usuario.telefono ?? "";
        occupation.value = usuario.ocupacion ?? "";

        if (isStudent) {
        nationality.value = usuario.nacionalidad ?? "";
        residence.value = usuario.domicilio ?? "";
        studyLevel.value = usuario.nivel_estudio ?? "";
        disability.value = usuario.discapacidad ?? "";
        socialProgram.value = usuario.programa_social ?? "";
        estadoCivil.value = usuario.estado_civil ?? "";
        }
    })
    .catch(err => {
        alert("No se pudo cargar el usuario.");
        console.error(err);
    });

  }

  // Envío del formulario (PUT)
  if (form) {
    form.addEventListener("submit", async (event: Event) => {
      event.preventDefault();

      const formData = isStudent
        ? {
            telefono: phone.value,
            nacionalidad: nationality.value,
            domicilio: residence.value,
            ocupacion: occupation.value,
            programa_social: socialProgram.value,
            discapacidad: disability.value,
            nivel_estudio: studyLevel.value,
            nombre: name.value,
            apellido: lastName.value,
            contrasena: password.value,
            fecha_nacimiento: birthDay.value,
            correo: email.value,
            dni: dni.value,
            estado_civil: estadoCivil.value
          }
        : {
            ocupacion: occupation.value,
            nombre: name.value,
            apellido: lastName.value,
            contrasena: password.value,
            fecha_nacimiento: birthDay.value,
            correo: email.value,
            dni: dni.value,
            telefono: phone.value
          };

      try {
        const endpoint = `http://localhost:4000/api/${tipoParam}/${currentId}`;
        const response = await fetch(endpoint, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(formData)
        });

        if (!response.ok) throw new Error("Error al enviar los datos");

        alert(isStudent ? "Alumno actualizado" : "Personal actualizado");
        form.reset();
        window.location.href = "/gestion-de-usuarios";
      } catch (error) {
        alert("Error: " + (error instanceof Error ? error.message : String(error)));
      }
    });
  }
});


</script>
