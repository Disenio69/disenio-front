</DashboardLayout>

<script>
  
//@ts-nocheck
import { jwtDecode } from 'jwt-decode'
import {Notification} from '../components/notifications'
import { checkInputNumbers } from '../components/validations'
const token = localStorage.getItem('token')
let payload
const selectCurso = document.getElementById('select-curso')
let cursoSeleccionado = {}
let examenes = []

document.addEventListener('DOMContentLoaded', async () => {
  payload = obtenerToken()
  await cargarDatos()
})

async function obtenerExamenes(curso){
try {
    const res = await fetch(`http://localhost:4000/api/material/examenes/curso/${curso.id}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if (!res.ok) {
      console.error('Error al obtener exámenes')
      return
    }

    const json = await res.json()
    const examenes = json.body

    const tbody = document.querySelector('tbody')
    tbody.innerHTML = '' // Limpiar tabla antes de insertar

    examenes.forEach(examen => {
      const tr = document.createElement('tr')

      tr.innerHTML = `
        <th class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 text-left text-sm font-bold text-xs">
          ${examen.dni}
        </th>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">
          ${examen.nombre} ${examen.apellido}
        </td>
        <td class="border-t-0 px-6 align-center border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">
          ${examen.observacion}
        </td>
        <td class="border-t-0 px-6 align-center border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">
          ${examen.calificacion}
        </td>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 text-xs whitespace-nowrap p-4">
          <button class="mr-2 rounded-3xl bg-sky-400 w-6 h-6"><i class="fa-solid fa-pen-to-square" style="color: #000000;"></i></button>
          <button class="rounded-3xl bg-red-600 w-6 h-6"><i class="fa-solid fa-xmark" style="color: #000000;"></i></button>
        </td>
      `

      tbody.appendChild(tr)
    })
    return examenes

  } catch (error) {
    console.error('Error al cargar exámenes:', error)
  }
}

function obtenerToken() {
  const base64Url = token.split('.')[1]
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(function (c) {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
  }).join(''))
  payload = JSON.parse(jsonPayload)
  if (!['alumno', 'profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())) {
    window.location.href = '/inicio'
  }
  return payload
}

async function cargarDatos() {
    const resCursos = await fetch(`http://localhost:4000/api/curso/personal/${payload.id}/cursos`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if (!resCursos.ok) {
      console.error('Error al traer cursos')
      return
    }

    const data = await resCursos.json()
    const cursos = data.body

    selectCurso.innerHTML = `<option class="bg-gray-200" value="" disabled selected>Seleccionar curso</option>`

    if (cursos.length > 0) {
      cursos.forEach(curso => {
        const option = document.createElement('option')
        option.value = curso.id
        option.innerText = curso.nombre
        option.classList.add('bg-gray-200')
        selectCurso.appendChild(option)
      })
    }

    selectCurso.addEventListener('change', async (e) => {
      cursoSeleccionado = cursos.find(curso => curso.id == e.target.value)
      if (cursoSeleccionado) {
            examenes = await obtenerExamenes(cursoSeleccionado)
            
      }})

      document.getElementById('cargarExamen')?.addEventListener('click',async()=>{
        const modal = document.createElement('DIV')
        modal.innerHTML = `
            <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
              <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
                <h2 class="text-xl font-semibold text-gray-800">Cargar examén</h2>
                <div class="flex items-center space-x-4">
                  <input type="file" id="examenInput" accept="image/jpeg,image/png,image/webp" class="block w-full rounded-lg border border-gray-300 bg-blue-600 text-white file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-white file:text-blue-600 hover:file:bg-gray-100 transition">
                </div>
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">DNI alumno</label>
                <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="dni" type="text">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">Subir con el nombre de:</label>
                <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="observacion" type="text" placeholder="0.00">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">Nota</label>
                <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="calificacion" type="text" placeholder="0.00">
                <div class="flex justify-end gap-2">
                  <button id="cargarExamenModal" class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-500">Subir examen</button>
                  <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Cancelar</button>
                </div>
              </div>
            </div>`
        document.body.appendChild(modal)
        document.getElementById('cancelarModal').addEventListener('click',()=> modal.remove())
        document.getElementById('cargarExamenModal')?.addEventListener('click',async ()=>{
          Notification.prototype.deletePreviousNotification()
          const calificacion = document.getElementById('calificacion')
          const calificacionValue = document.getElementById('calificacion').value
          const observacion = document.getElementById('observacion').value
          const archivo = document.getElementById('examenInput')
          const dni = Number(document.getElementById('dni').value)
          let alumno = {}
          try {
            const resAlumnosCurso = await fetch(`http://localhost:4000/api/curso/${cursoSeleccionado.id}/alumnos-simples`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              }
            })

            if (!resAlumnosCurso.ok) {
              console.error('Error al traer los alumnos del curso')
              return
            }


            const dataAlumnosCurso = await resAlumnosCurso.json()
            const alumnos = dataAlumnosCurso.body

            alumno = alumnos.filter(alumno => alumno.dni === dni)

          } catch (error) {
            console.error(error)
          }

          if (calificacionValue.length < 1 || calificacionValue.length > 3) {
            new Notification(`Este campo no puede quedar en blanco introduzca un número como: 8 o 8.50`, 'error', calificacion)
            return
          }
          else{
              if (!/^\d+(\.\d+)?$/.test(calificacionValue)) {
                  new Notification("Introduzca un numero valido, como: 8 o 8.50", 'error', calificacion)
                  return 
              }
              else{
                if(archivo.files.length > 0){
                  enviarExamen(alumno[0].id,calificacionValue,observacion,archivo.files[0],cursoSeleccionado.id)
                  modal.remove()
                  
                }        
              }
          }
                            
        })

      })
    

}

async function enviarExamen(alumno_id, calificacion, observacion, archivo, curso_id) {
  try {
    const formData = new FormData()
    formData.append('observacion', observacion)
    formData.append('curso_id', curso_id)
    formData.append('alumno_id', alumno_id)
    formData.append('archivo', archivo)
    formData.append('calificacion', calificacion)

    const res = await fetch('http://localhost:4000/api/material/examen', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`
        // NO pongas 'Content-Type': 'application/json', porque fetch la genera automáticamente para FormData
      },
      body: formData
    })

    const json = await res.json()
    console.log('Respuesta:', json)
  } catch (error) {
    console.error('Error al enviar examen:', error)
  }
}



</script>