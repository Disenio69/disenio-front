---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title='Realizar titulación' path='titulación' pageTitle='Titulacion de estudiantes'>
  <div class="flex items-center space-x-4 ml-10">
    <button id="abrir-modal-titular" class="rounded-3xl bg-blue-700 px-10 py-1.5 text-white text-sm mr-0">Titular estudiante</button>
    <div class="relative w-[250px]">
      <select id="select-anio" class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg">
        <option value="">Todos los años</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>
  </div>
  <span class="float-right mr-14">
    <span class="text-sm text-gray-700">Descargar como:</span>
    <i id="download-csv" class="fa-solid fa-file-csv fa-xl cursor-pointer text-[color:#217346] hover:text-green-800 transition-colors duration-200 ml-2" title="Descargar CSV"></i>
  </span>

  <div class="mb-10 mt-5">
    <div class="xl:w-full px-10">
      <div class="flex flex-col min-w-0 break-words bg-white w-full shadow-lg rounded">
        <div class="rounded-t mb-0 px-4 py-3 border-0">
          <div class="flex flex-wrap items-center">
            <div class="relative w-full px-2 flex-grow flex-1">
              <h3 class="font-semibold text-base text-blueGray-700">Lista de estudiantes titulados</h3>
            </div>
            <div class="relative sm:text-right flex items-center">
              <input id="search-input" class="border-2 border-black text-black text-xs font-bold px-7 py-1 rounded-full" type="text" placeholder="Buscar">
              <i class="relative md:visible invisible top-0.5 right-48 fa-solid fa-magnifying-glass" style="color: #000000;"></i>
              <select id="search-type" class="border-2 border-black text-black text-xs font-bold px-3 py-1 rounded-full">
                <option value="curso">Curso</option>
                <option value="dni">DNI</option>
              </select>
            </div>
          </div>
        </div>

        <div class="block w-full overflow-x-auto">
          <table class="items-center bg-transparent w-full border-collapse">
            <thead>
              <tr>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">DNI</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Nombre</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Apellido</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Curso</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Estado</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Opciones</th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-sm text-gray-700">Mostrando <span id="paginationStart"></span> de <span id="paginationEnd"></span> de <span id="totalPagination"></span> entradas</span>
        <div class="inline-flex mt-2">
          <button id="previousPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 rounded-s hover:bg-gray-900">Anterior</button>
          <button id="nextPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 border-s hover:bg-gray-900">Siguiente</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
//@ts-nocheck
import { downloadCsv } from '../components/downloadTable'

let data = []
let filteredData = []
const limitcolums = 5
let currentStart = 0
let currentEnd = currentStart + limitcolums
const token = localStorage.getItem('token')

const selectAnio = document.getElementById('select-anio')
const searchInput = document.getElementById('search-input')
const searchType = document.getElementById('search-type')

async function fetchData() {
  const response = await fetch('http://localhost:4000/api/curso/alumnos-cursos', {
    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }
  })
  const json = await response.json()
  data = json.body.filter(item => item.estado_terminacion === 'egresado')
  const anios = [...new Set(data.map(d => parseInt(d.anio)))].sort((a, b) => b - a)
  anios.forEach(anio => {
    const opt = document.createElement('option')
    opt.value = anio
    opt.textContent = anio
    selectAnio.appendChild(opt)
  })
  filteredData = [...data]
}

function filtrarDatos() {
  const filtro = searchInput.value.trim().toLowerCase()
  const tipo = searchType.value
  const selectedAnio = selectAnio.value

  filteredData = data

  if (selectedAnio) {
    filteredData = filteredData.filter(item => String(item.anio) === selectedAnio)
  }

  if (filtro) {
    if (tipo === 'curso') {
      filteredData = filteredData.filter(item => item.curso_nombre.toLowerCase().includes(filtro))
    } else if (tipo === 'dni') {
      filteredData = filteredData.filter(item => String(item.dni).startsWith(filtro))
    }
  }

  currentStart = 0
  currentEnd = currentStart + limitcolums
  renderPage()
}

function renderPage(currentData = filteredData) {
  const tbody = document.getElementById('tbody')
  tbody.innerHTML = ""
  const paginated = currentData.slice(currentStart, currentEnd)
  paginated.forEach(item => {
    const tr = document.createElement('tr')
    tr.innerHTML = `
      <td class="border-t-0 px-6 p-4 text-left text-sm font-bold text-xs">${item.dni}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.nombre}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.apellido}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.curso_nombre}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.estado_terminacion}</td>
      <td class="border-t-0 px-6 p-4">-</td>
    `
    tbody.appendChild(tr)
  })
  checkButton()
}

function checkButton() {
  const btnPrev = document.getElementById('previousPage')
  const btnNext = document.getElementById('nextPage')
  btnPrev.disabled = currentStart === 0
  btnNext.disabled = currentStart + limitcolums >= filteredData.length
  document.getElementById('paginationStart').textContent = currentStart + 1
  document.getElementById('paginationEnd').textContent = Math.min(currentEnd, filteredData.length)
  document.getElementById('totalPagination').textContent = filteredData.length
}

document.getElementById('nextPage').addEventListener('click', () => {
  if (currentStart + limitcolums < filteredData.length) {
    currentStart += limitcolums
    currentEnd = Math.min(currentStart + limitcolums, filteredData.length)
    renderPage()
  }
})

document.getElementById('previousPage').addEventListener('click', () => {
  if (currentStart - limitcolums >= 0) {
    currentStart -= limitcolums
    currentEnd = currentStart + limitcolums
    renderPage()
  }
})

searchInput.addEventListener('input', filtrarDatos)
searchType.addEventListener('change', filtrarDatos)
selectAnio.addEventListener('change', filtrarDatos)

document.getElementById('download-csv').addEventListener('click', () => {
  downloadCsv(filteredData, 'tabla-estudiantes-egresados')
})

document.getElementById('abrir-modal-titular').addEventListener('click', async () => {
  let alumnos = []
  try {
    const res = await fetch('http://localhost:4000/api/curso/alumnos-cursos', {
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }
    })
    const json = await res.json()
    alumnos = json.body.filter(a => a.estado_terminacion === 'cursando')
  } catch (error) {
    console.error("Error al obtener alumnos", error)
  }

  const anios = [...new Set(alumnos.map(a => a.anio))].sort((a, b) => b - a)

  const modal = document.createElement('DIV')
  modal.innerHTML = `
    <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <h2 class="text-xl font-semibold text-gray-800">Titular estudiante</h2>
        <label class="block text-gray-700 text-sm font-bold">Año</label>
        <select id="select-anio-modal" class="block w-full bg-gray-200 rounded py-2 px-3 mb-3">
          <option value="">Seleccionar año</option>
          ${anios.map(anio => `<option value="${anio}">${anio}</option>`).join('')}
        </select>
        <label class="block text-gray-700 text-sm font-bold">Alumno</label>
        <select id="select-alumno-modal" class="block w-full bg-gray-200 rounded py-2 px-3 mb-3">
          <option value="">Seleccionar alumno</option>
        </select>
        <div id="curso-container" class="hidden">
          <label class="block text-gray-700 text-sm font-bold">Curso</label>
          <select id="select-curso-modal" class="block w-full bg-gray-200 rounded py-2 px-3 mb-3">
            <option value="">Seleccionar curso</option>
          </select>
        </div>
        <label class="block text-gray-700 text-sm font-bold">Nota</label>
        <input id="nota-input" type="number" class="block w-full bg-gray-200 rounded py-2 px-3 mb-3" placeholder="Ingrese nota">
        <div class="flex justify-end gap-2">
          <button id="btn-egresar" class="px-4 py-2 bg-green-700 text-white rounded hover:bg-green-600">Egresar</button>
          <button id="btn-cancelar" class="px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600">Cancelar</button>
        </div>
      </div>
    </div>`
  document.body.appendChild(modal)

  document.getElementById('select-anio-modal').addEventListener('change', (e) => {
    const anioSeleccionado = e.target.value
    const alumnosFiltrados = alumnos.filter(a => String(a.anio) === anioSeleccionado)
    const selectAlumno = document.getElementById('select-alumno-modal')
    selectAlumno.innerHTML = `<option value="">Seleccionar alumno</option>` + alumnosFiltrados.map(a => `<option value="${a.id_alumno}">${a.nombre} ${a.apellido} - ${a.dni}</option>`).join('')
    document.getElementById('curso-container').classList.add('hidden')
  })

  document.getElementById('select-alumno-modal').addEventListener('change', (e) => {
    const idAlumnoSeleccionado = e.target.value
    const cursosAlumno = alumnos
      .filter(a => String(a.id_alumno) === idAlumnoSeleccionado && a.estado_terminacion === 'cursando')
      .map(a => ({ id: a.id_curso, nombre: a.curso_nombre }))

    const selectCurso = document.getElementById('select-curso-modal')
    selectCurso.innerHTML = `<option value="">Seleccionar curso</option>` + cursosAlumno.map(c => `<option value="${c.id}">${c.nombre}</option>`).join('')
    document.getElementById('curso-container').classList.remove('hidden')
  })

  document.getElementById('btn-cancelar').addEventListener('click', () => modal.remove())

  document.getElementById('btn-egresar').addEventListener('click', async () => {
    const idAlumno = document.getElementById('select-alumno-modal').value
    const idCurso = document.getElementById('select-curso-modal').value
    const nota = document.getElementById('nota-input').value

    if (!idAlumno || !idCurso || !nota) {
      showModal('Error', 'Debe seleccionar alumno, curso y poner nota.', 'bg-red-600')
      return
    }

    try {
      const res = await fetch('http://localhost:4000/api/curso/egresar-alumno', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ id_alumno: idAlumno, id_curso: idCurso, nota: nota })
      })
      if (!res.ok) throw new Error("Error al egresar alumno")

      modal.remove()
      await fetchData()
      renderPage()
      showModal('Éxito', 'Alumno egresado correctamente.', 'bg-green-600')
    } catch (error) {
      console.error("Error al egresar", error)
      showModal('Error', 'Hubo un error al egresar alumno.', 'bg-red-600')
    }
  })
})

function showModal(titulo, mensaje, color) {
  const modal = document.createElement('DIV')
  modal.innerHTML = `
    <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <h2 class="text-xl font-semibold text-gray-800">${titulo}</h2>
        <p class="text-gray-700">${mensaje}</p>
        <div class="flex justify-end">
          <button id="btn-ok" class="px-4 py-2 ${color} text-white rounded hover:opacity-90">OK</button>
        </div>
      </div>
    </div>`
  document.body.appendChild(modal)

  document.getElementById('btn-ok').addEventListener('click', () => modal.remove())
}

document.addEventListener('DOMContentLoaded', async () => {
  await fetchData()
  renderPage()
})
</script>
