---
import DashboardLayout from "../layouts/Dashboard-Layout.astro";
---

<DashboardLayout title="Corrección de prácticos" path="Corrección de prácticos" pageTitle="Corrección de prácticos">
  <div class="flex items-center space-x-4">

    <div class="relative w-[320px] ml-10">
      <select class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg" id="select-curso" name="curso">
        <option value="" disabled selected>Seleccionar curso</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>

    <div class="relative w-[330px]">
      <select class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg" id="select-carpeta" name="carpeta">
        <option value="" disabled selected>Seleccionar carpeta</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>
  </div>

  <span class="float-right mr-14 mb-2">
    <span class="text-sm text-gray-700">Descargar como:</span>
    <i class="fa-solid fa-file-csv fa-xl cursor-pointer text-[color:#217346] hover:text-green-800 transition-colors duration-200 ml-2" title="Descargar CSV"></i>
  </span>
  <!------------------------TABLE-------------------- -->
  <!------------------------TABLE-------------------- -->
  <div class="mb-10 mt-5">
    <div class="xl:w-full px-10">
      <div class="retive flex flex-col min-w-0 break-words bg-white w-full shadow-lg rounded">
        <div class="rounded-t mb-0 px-4 py-3 border-0">
          <div class="flex flex-wrap items-center">
            <div class="relative w-full px-2 flex-grow flex-1">
              <h3 class="font-semibold text-base text-blueGray-700">Prácticos cargados</h3>
            </div>
            <div class="relative flex-grow flex-1 sm:text-right">
              <input class="border-2 border-black text-black text-xs font-bold px-7 py-1 rounded-full" type="text" placeholder="Buscar">
              <i class="relative md:visible invisible top-0.5 right-48 fa-solid fa-magnifying-glass" style="color: #000000;"></i>
            </div>
          </div>
        </div>
    
        <div class="block w-full overflow-x-auto">
          <table class="items-center bg-transparent w-full border-collapse ">
            <thead>
              <tr>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">DNI</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Nombre y apellido</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Estado</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Opciones</th>
              </tr>
            </thead>
    
            <tbody id="tbody">
            </tbody>
          </table>
        </div>
      </div>
  </div>
</DashboardLayout>

<script>
//@ts-nocheck
import { jwtDecode } from 'jwt-decode'
import {Notification} from '../components/notifications'
const token = localStorage.getItem('token')
let payload
const selectCurso = document.getElementById('select-curso')
const selectCarpeta = document.getElementById('select-carpeta')
let cursos = []
let practicos = []
let materiales = []
let currentPage = 1
const rowsPerPage = 5
let currentData = []


document.addEventListener('DOMContentLoaded', async () => {
  payload = obtenerToken()
  practicos = await obtenerPracticos()
  await cargarDatos()
})



async function obtenerPracticos(){
    const resPracticos = await fetch(`http://localhost:4000/api/material`, {
    method: 'GET',
    headers: { 'Authorization': `Bearer ${token}` }
  })
  const JsonPracticos = await resPracticos.json()
  console.log(JsonPracticos.body)
  return JsonPracticos.body
}

function obtenerToken() {
  const base64Url = token.split('.')[1]
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(function (c) {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
  }).join(''))
  payload = JSON.parse(jsonPayload)
  if (!['alumno', 'profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())) {
    window.location.href = '/inicio'
  }
  return payload
}

async function cargarDatos() {
  try {
    const resCursos = await fetch(`http://localhost:4000/api/curso/personal/${payload.id}/cursos`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if (!resCursos.ok) {
      console.error('Error al traer cursos')
      return
    }

    const data = await resCursos.json()
    cursos = data.body

    selectCurso.innerHTML = `<option class="bg-gray-200" value="" disabled selected>Seleccionar curso</option>`

    if (cursos.length > 0) {
      cursos.forEach(curso => {
        const option = document.createElement('option')
        option.value = curso.id
        option.innerText = curso.nombre
        selectCurso.appendChild(option)
      })
    }

    selectCurso.addEventListener('change', async (e) => {
      const cursoSeleccionado = cursos.find(curso => curso.id == e.target.value)
      if (cursoSeleccionado) {
        try {

          // Filtrar materiales por curso
          const practicosCurso = practicos.filter(prac => prac.curso_id == cursoSeleccionado.id)


          //Cargar datos select carpeta
          selectCarpeta.innerHTML = `<option class="bg-gray-200" value="" disabled selected>Seleccionar carpeta</option>`
          practicosCurso.forEach(pracCur => {
            if(pracCur.carpeta){
              const option = document.createElement('option')
              option.value = pracCur.carpeta
              option.innerText = pracCur.carpeta
              selectCarpeta.appendChild(option)
            }
          });

          // Evento change carpeta
          selectCarpeta.addEventListener('change', async (e) => {
            const carpetaSeleccionada = e.target.value
            const tbody = document.getElementById('tbody')
            tbody.innerHTML = ''

            // Filtrar materiales por carpeta
            const practicosFiltrados = practicosCurso.filter(matCur => matCur.carpeta === carpetaSeleccionada)
            const alumnos = await fetchAlumnos()

            for (const material of practicosFiltrados) {
              const alumnoId = material.alumno_id
              const estado = material.estado
              const alumnoFiltrado = alumnos.find(alumno => alumno.id === alumnoId)
              console.log(alumnoFiltrado)

              if(alumnoFiltrado){
                  const tr = document.createElement('tr')

                  const thDni = document.createElement('th')
                  thDni.className = 'border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 text-left text-sm font-bold text-xs'
                  thDni.textContent = alumnoFiltrado.dni

                  const tdNombre = document.createElement('td')
                  tdNombre.className = 'border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs'
                  tdNombre.textContent = `${alumnoFiltrado.nombre} ${alumnoFiltrado.apellido}`

                  const tdEstado = document.createElement('td')
                  tdEstado.className = 'border-t-0 px-6 align-center border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs'
                  tdEstado.textContent = estado || 'Sin corregir'

                  const tdOpciones = document.createElement('td')
                  tdOpciones.className = 'border-t-0 px-6 align-middle border-l-0 border-r-0 text-xs whitespace-nowrap p-4'

                  const btn = document.createElement('button')
                  btn.className = 'mr-2 rounded-3xl bg-blue-700 py-1 px-3 text-white text-xs'
                  btn.textContent = 'Corregir'

                  const practico = practicos.find(p => p.alumno_id === alumnoId)

                  btn.addEventListener('click',()=>{
                    const modal = document.createElement('DIV')
                    modal.innerHTML = `
                        <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
                          <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
                            <h2 class="text-xl font-semibold text-gray-800">Corregir trabajo</h2>
                            <p><strong>Archivo: <a href="http://localhost:4000/api/material/descargar/${practico.id}" class="text-blue-600 underline hover:text-blue-800">${practico.observacion}</a></strong></p>
                            <p><strong>Estado: ${practico.estado === 'enviado'? 'recibido' : practico.estado}</strong></p>
                            <p><strong>Nota: ${practico.calificacion}</strong></p>
                            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">
                              Calificación
                            </label>
                            <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="calificacion" type="text" placeholder="0.00">
                            <div class="flex justify-end gap-2">
                              <button id="calificarModal" class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-500">Calificar</button>
                              <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Cancelar</button>
                            </div>
                          </div>
                        </div>`
                    document.body.appendChild(modal)
                    document.getElementById('cancelarModal').addEventListener('click',()=> modal.remove())
                                      document.getElementById('calificarModal').addEventListener('click', ()=> {
                                      const input = document.getElementById('calificacion')
                                      const inputValue = Number(document.getElementById('calificacion').value)
                                      if (inputValue.length < 1 || inputValue.length > 3) {
                                              new Notification(`Este campo no puede quedar en blanco introduzca un número como: 8 o 8.50`, 'error', input)
                                              return
                                          }
                                          else{
                                              if (!/^\d+$/.test(inputValue)) {
                                                  new Notification("Introduzca un numero valido, como: 8 o 8.50", 'error', input)
                                                  return 
                                              }
                                              else{
                                                  modal.remove()
                                                  calificar(inputValue,alumnoId,practico.carpeta)
                                              }
                                          }
                                      }
                                    )
                    }
                )

                  tdOpciones.appendChild(btn)

                  tr.appendChild(thDni)
                  tr.appendChild(tdNombre)
                  tr.appendChild(tdEstado)
                  tr.appendChild(tdOpciones)

                  tbody.appendChild(tr)
              }
            }
          })
        } catch (error) {
          console.error(error)
        }
      }
    })

  } catch (error) {
    console.error('Error en la petición:', error)
  }
}

function ModalConfirmacion(estado){
  const modalConfirmacion = document.createElement('DIV')
  modalConfirmacion.innerHTML = `
    <div id="modal-confirmacion" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg flex flex-col items-center space-y-4 relative">
        <h2 class="text-lg font-semibold text-gray-800 text-center">${estado? 'Guardado con éxito': 'Error al guardar'}</h2>
        ${estado? '<p class="text-base text-gray-500 text-center">Los cambios solo se verán al actualizar la página</p>' :''}
        <button id="cerrar" class="px-4 py-2 ${estado? 'bg-green-700 hover:bg-green-600': 'bg-red-700 hover:bg-red-600'} text-white rounded">Aceptar</button>
      </div>
    </div>`
  document.body.appendChild(modalConfirmacion)
  document.getElementById('cerrar').addEventListener('click', () => modalConfirmacion.remove())
}

async function calificar(inputValue, alumnoId,carpetaSelec) {
  try {
    const res = await fetch('http://localhost:4000/api/material/calificar', {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({
        id: alumnoId,
        calificacion: inputValue,
        carpeta : carpetaSelec
      })
    })

    const data = await res.json()

    if (!res.ok) {
      console.error('Error en la API:', data)
      return
    }
    ModalConfirmacion(true)

  } catch (error) {
    ModalConfirmacion(false)
    console.error('Error al enviar fetch:', error)
  }
}


async function fetchAlumnos() {
  try {
    const resAlumno = await fetch(`http://localhost:4000/api/alumno`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if (!resAlumno.ok) {
      console.error('Error al traer el alumno')
      return null
    }

    const dataAlumno = await resAlumno.json()
    return dataAlumno.body
  } catch (error) {
    console.error(error)
    return null
  }
}

async function obtenerMateriales(){
  const resMateriales = await fetch(`http://localhost:4000/api/material`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    }
    })

  if (!resMateriales.ok) {
  console.error('Error al traer los materiales')
  return
  }

  const dataMateriales = await resMateriales.json()
  return dataMateriales.body
}
</script>

