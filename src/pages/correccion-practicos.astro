---
import DashboardLayout from "../layouts/Dashboard-Layout.astro";
---

<DashboardLayout title="Corrección de prácticos" path="Corrección de prácticos" pageTitle="Corrección de prácticos">
  <div class="flex items-center space-x-4">
    <div class="relative w-[320px] ml-10">
      <select class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg" id="select-curso" name="curso">
        <option value="" disabled selected>Seleccionar curso</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>

    <div class="relative w-[330px]">
      <select class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg" id="select-carpeta" name="carpeta">
        <option value="" disabled selected>Seleccionar carpeta</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>
  </div>

  <span class="float-right mr-14 mb-2">
    <span class="text-sm text-gray-700">Descargar como:</span>
    <i class="fa-solid fa-file-csv fa-xl cursor-pointer text-[color:#217346] hover:text-green-800 transition-colors duration-200 ml-2" title="Descargar CSV"></i>
  </span>

  <div class="mb-10 mt-5">
    <div class="xl:w-full px-10">
      <div class="retive flex flex-col min-w-0 break-words bg-white w-full shadow-lg rounded">
        <div class="rounded-t mb-0 px-4 py-3 border-0">
          <div class="flex flex-wrap items-center">
            <div class="relative w-full px-2 flex-grow flex-1">
              <h3 class="font-semibold text-base text-blueGray-700">Prácticos cargados</h3>
            </div>
            <div class="relative flex-grow flex-1 sm:text-right">
              <input class="border-2 border-black text-black text-xs font-bold px-7 py-1 rounded-full" id="search-by-dni" type="text" placeholder="Buscar">
              <i class="relative md:visible invisible top-0.5 right-48 fa-solid fa-magnifying-glass" style="color: #000000;"></i>
            </div>
          </div>
        </div>

        <div class="block w-full overflow-x-auto">
          <table class="items-center bg-transparent w-full border-collapse">
            <thead>
              <tr>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">DNI</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Nombre y apellido</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Estado</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Opciones</th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
      </div>

      <!-- PAGINATION -->
      <div class="flex flex-col items-center mt-4">
        <span class="text-sm text-gray-700">Mostrando <span id="paginationStart"></span> a <span id="paginationEnd"></span> de <span id="totalPagination"></span> entradas</span>
        <div class="inline-flex mt-2">
          <button id="previousPage" disabled class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 rounded-s hover:bg-gray-900 opacity-50 cursor-not-allowed">Anterior</button>
          <button id="nextPage" disabled class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 border-s hover:bg-gray-900 opacity-50 cursor-not-allowed">Siguiente</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
//@ts-nocheck
import { Notification } from '../components/notifications'
const token = localStorage.getItem('token')
let payload
const selectCurso = document.getElementById('select-curso')
const selectCarpeta = document.getElementById('select-carpeta')
let cursos = []
let practicos = []
let currentData = []
let currentPage = 1
const rowsPerPage = 5

const paginationStart = document.getElementById('paginationStart')
const paginationEnd = document.getElementById('paginationEnd')
const totalPagination = document.getElementById('totalPagination')
const previousPageBtn = document.getElementById('previousPage')
const nextPageBtn = document.getElementById('nextPage')

document.addEventListener('DOMContentLoaded', async () => {
  payload = obtenerToken()
  practicos = await obtenerPracticos()
  await cargarDatos()
})

async function obtenerPracticos(){
  const res = await fetch(`http://localhost:4000/api/material`, { headers: { 'Authorization': `Bearer ${token}` } })
  const json = await res.json()
  return json.body
}

function obtenerToken() {
  const base64Url = token.split('.')[1]
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''))
  payload = JSON.parse(jsonPayload)
  if (!['alumno', 'profesor', 'administrador'].includes(payload.ocupacion.toLowerCase())) {
    window.location.href = '/inicio'
  }
  return payload
}

async function cargarDatos() {
  const resCursos = await fetch(`http://localhost:4000/api/curso/personal/${payload.id}/cursos`, { headers: { 'Authorization': `Bearer ${token}` } })
  const data = await resCursos.json()
  cursos = data.body

  selectCurso.innerHTML = `<option value="" disabled selected>Seleccionar curso</option>`
  cursos.forEach(curso => {
    const option = document.createElement('option')
    option.value = curso.id
    option.innerText = curso.nombre
    selectCurso.appendChild(option)
  })

  selectCurso.addEventListener('change', () => {
    const cursoSeleccionado = cursos.find(curso => curso.id == selectCurso.value)
    if (cursoSeleccionado) {
      const practicosCurso = practicos.filter(p => p.curso_id == cursoSeleccionado.id)
      selectCarpeta.innerHTML = `<option value="" disabled selected>Seleccionar carpeta</option>`
      practicosCurso.forEach(p => {
        if (p.carpeta) {
          const option = document.createElement('option')
          option.value = p.carpeta
          option.innerText = p.carpeta
          selectCarpeta.appendChild(option)
        }
      })

      selectCarpeta.addEventListener('change', async () => {
        const carpeta = selectCarpeta.value
        const practicosFiltrados = practicosCurso.filter(p => p.carpeta === carpeta)
        const alumnos = await fetchAlumnos()
        practicosFiltrados.forEach(p => { p.alumno = alumnos.find(a => a.id === p.alumno_id) })
        currentData = practicosFiltrados
        currentPage = 1
        renderPage()
      })
    }
  })
}

function renderPage(data = currentData) {
  const tbody = document.getElementById('tbody')
  tbody.innerHTML = ''
  const start = (currentPage - 1) * rowsPerPage
  const end = start + rowsPerPage
  const pageData = data.slice(start, end)

  pageData.forEach(material => {
    const alumno = material.alumno
    if (alumno) {
      const tr = document.createElement('tr')
      tr.innerHTML = `
        <th class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 text-left text-sm font-bold text-xs">${alumno.dni}</th>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${alumno.nombre} ${alumno.apellido}</td>
        <td class="border-t-0 px-6 align-center border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${material.estado || 'Sin corregir'}</td>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 text-xs whitespace-nowrap p-4">
          <button class="mr-2 rounded-3xl bg-blue-700 py-1 px-3 text-white text-xs corregir-btn">Corregir</button>
        </td>
      `
      const btn = tr.querySelector('.corregir-btn')
      btn.addEventListener('click', () => abrirModal(material, alumno))
      tbody.appendChild(tr)
    }
  })

  paginationStart.textContent = start + 1
  paginationEnd.textContent = Math.min(end, currentData.length)
  totalPagination.textContent = currentData.length

  // Controlar estado de botones y opacidad
  if (currentPage === 1) {
    previousPageBtn.disabled = true
    previousPageBtn.classList.add('opacity-50', 'cursor-not-allowed')
  } else {
    previousPageBtn.disabled = false
    previousPageBtn.classList.remove('opacity-50', 'cursor-not-allowed')
  }

  if (currentPage >= Math.ceil(currentData.length / rowsPerPage)) {
    nextPageBtn.disabled = true
    nextPageBtn.classList.add('opacity-50', 'cursor-not-allowed')
  } else {
    nextPageBtn.disabled = false
    nextPageBtn.classList.remove('opacity-50', 'cursor-not-allowed')
  }
}


previousPageBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderPage() } })
nextPageBtn.addEventListener('click', () => { if (currentPage < Math.ceil(currentData.length / rowsPerPage)) { currentPage++; renderPage() } })

async function fetchAlumnos() {
  const res = await fetch(`http://localhost:4000/api/alumno`, { headers: { 'Authorization': `Bearer ${token}` } })
  const data = await res.json()
  return data.body
}

function abrirModal(practico, alumno) {
  const modal = document.createElement('DIV')
  modal.innerHTML = `
    <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
        <h2 class="text-xl font-semibold text-gray-800">Corregir trabajo</h2>
        <p><strong>Archivo: <a href="http://localhost:4000/api/material/descargar/${practico.id}" class="text-blue-600 underline hover:text-blue-800">${practico.observacion}</a></strong></p>
        <p><strong>Estado: ${practico.estado === 'enviado' ? 'recibido' : practico.estado}</strong></p>
        <p><strong>Nota: ${practico.calificacion}</strong></p>
        <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2">Calificación</label>
        <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="calificacion" type="text" placeholder="0.00">
        <div class="flex justify-end gap-2">
          <button id="calificarModal" class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-500">Calificar</button>
          <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Cancelar</button>
        </div>
      </div>
    </div>`
  document.body.appendChild(modal)
  document.getElementById('cancelarModal').addEventListener('click', () => modal.remove())
  document.getElementById('calificarModal').addEventListener('click', () => {
    const inputValue = Number(document.getElementById('calificacion').value)
    if (!inputValue) {
      new Notification("Introduzca un número válido", 'error')
      return
    }
    modal.remove()
    calificar(inputValue, alumno.id, practico.carpeta)
  })
}

async function calificar(nota, alumnoId, carpeta) {
  try {
    const res = await fetch('http://localhost:4000/api/material/calificar', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
      body: JSON.stringify({ id: alumnoId, calificacion: nota, carpeta })
    })
    if (!res.ok) throw new Error()
    ModalConfirmacion(true)
  } catch {
    ModalConfirmacion(false)
  }
}

function ModalConfirmacion(estado) {
  const modal = document.createElement('DIV')
  modal.innerHTML = `
    <div id="modal-confirmacion" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg flex flex-col items-center space-y-4 relative">
        <h2 class="text-lg font-semibold text-gray-800 text-center">${estado ? 'Guardado con éxito' : 'Error al guardar'}</h2>
        ${estado ? '<p class="text-base text-gray-500 text-center">Los cambios solo se verán al actualizar la página</p>' : ''}
        <button id="cerrar" class="px-4 py-2 ${estado ? 'bg-green-700 hover:bg-green-600' : 'bg-red-700 hover:bg-red-600'} text-white rounded">Aceptar</button>
      </div>
    </div>`
  document.body.appendChild(modal)
  document.getElementById('cerrar').addEventListener('click', () => modal.remove())
}

document.getElementById('search-by-dni').addEventListener('input', () => {
  const filtro = document.getElementById('search-by-dni').value.trim()
  currentPage = 1

  if (filtro === "") {
    renderPage(currentData)
  } else {
    const filteredData = currentData.filter(item => String(item.alumno.dni).startsWith(filtro))
    renderPage(filteredData)
  }
})

</script>
