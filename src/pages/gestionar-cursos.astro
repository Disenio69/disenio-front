---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title="Gestion de cursos" path='Gestion de cursos' pageTitle='Gestion de cursos'>
      <button class="rounded-3xl bg-blue-700 px-10 py-1.5 text-white text-lg ml-10 mr-0" id="agregar-nuevo-curso">Agregar curso</button>
      <button class="rounded-3xl bg-blue-700 px-10 py-1.5 text-white text-lg ml-10 mr-0" id="agregar-profesor-curso">Asignar profesor al curso</button>
      <span class="float-right mr-14">
        <span class="text-sm text-gray-700">Descargar como:</span>
        <i id="download-csv" class="fa-solid fa-file-csv fa-xl cursor-pointer text-[color:#217346] hover:text-green-800 transition-colors duration-200 ml-2" title="Descargar CSV"></i>
      </span>
            <!------------------------TABLE-------------------- -->
            <!------------------------TABLE-------------------- -->
          <div id="mainDiv" class="mt-5 pb-5">
            <div class="xl:w-full px-10">
              <div class="retive flex flex-col min-w-0 break-words bg-white w-full shadow-lg rounded mb-5">
                <div class="rounded-t mb-0 px-4 py-3 border-0">
                  <div class="flex flex-wrap items-center">
                    <div class="relative w-full px-2 flex-grow flex-1">
                      <h3 class="font-semibold text-base text-blueGray-700">Lista de cursos</h3>
                    </div>
                    <div class="relative sm:text-right flex items-center">
                      <input id="search-by-name" class="border-2 border-black text-black text-xs font-bold px-7 py-1 rounded-full" type="text" placeholder="Buscar">
                      <i class="relative md:visible invisible top-0.5 right-48 fa-solid fa-magnifying-glass" style="color: #000000;"></i>
                      <select id="search-type" class="border-2 border-black text-black text-xs font-bold px-3 py-1 rounded-full">
                        <option value="nombre">Nombre</option>
                        <option value="profesor">Profesor</option>
                      </select>
                    </div>
                  </div>
                </div>
            
                <div class="block w-full overflow-x-auto">
                  <table class="items-center bg-transparent w-full border-collapse ">
                    <thead>
                      <tr>
                        <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Nombre</th>
                        <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Profesores</th>
                        <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Descripción</th>
                        <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Grado academico</th>
                        <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Duración</th>
                        <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">Opción</th>
                      </tr>
                    </thead>
            
                    <tbody id="tbody">
                      <!-- Entradas de la tabla -->
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="flex flex-col items-center">
                <!-- Help text -->
                <span class="text-sm text-gray-700 dark:text-gray-400">
                    Mostrando <span class="font-semibold text-gray-900 dark:text-white" id="paginationStart"></span> de <span class="font-semibold text-gray-900 dark:text-white" id="paginationEnd"></span> de <span class="font-semibold text-gray-900 dark:text-white" id="totalPagination"></span> entradas
                </span>
                <div class="inline-flex mt-2 xs:mt-0">
                  <!-- Buttons -->
                <button id="previousPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 rounded-s hover:bg-gray-900 disabled:opacity-50" disabled>
                    Anterior
                </button>
                <button id="nextPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 border-s hover:bg-gray-900 disabled:opacity-50" disabled>
                    Siguiente
                </button>

                </div>
              </div>
          </div>
</DashboardLayout>

<style>
</style>

<script>
  //@ts-nocheck 
  import { downloadCsv } from '../components/downloadTable'
  import { moreInfoRow } from '../components/moreInfoRow'
  import * as validation from "../components/validations.ts"
  import { Notification } from "../components/notifications.js"

  //VARIABLES
  let data = null
  const limitcolums = 5
  const pag = 0
  let filteredData = null
  let currentStart = 0
  let currentEnd = currentStart + limitcolums
  const token = localStorage.getItem('token')

  async function fetchData(){
    const responseStudentsClass = await fetch('http://localhost:4000/api/curso',{
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`
    }
    })
    const jsoStudentsClass = await responseStudentsClass.json()
    
    data = jsoStudentsClass.body
    return data
  }

  async function loadData(){
      let tableContent =document.querySelector('#tbody')
      tableContent.innerHTML= ''
      data = await fetchData()
      renderPage()
  }

  //Cargar tabla al iniciar
  addEventListener('DOMContentLoaded', ()=> loadData())

  const btnNext = document.querySelector('#nextPage') as HTMLButtonElement
  btnNext.addEventListener('click', () => {
    if (currentStart + limitcolums < data.length) {
      currentStart += limitcolums
      currentEnd = Math.min(currentStart + limitcolums, data.length)
      renderPage()
    }
  })
  
  const btnPrev = document.querySelector('#previousPage') as HTMLButtonElement
  btnPrev.addEventListener('click', () => {
    if (currentStart - limitcolums >= 0) {
      currentStart -= limitcolums
      currentEnd = currentStart + limitcolums
      renderPage()
    }
  })

  function checkButton(){
    btnPrev.disabled = currentStart === 0
    btnNext.disabled = !Array.isArray(data) || currentStart + limitcolums >= data.length

    btnPrev.classList.toggle('disable-button', btnPrev.disabled)
    btnPrev.classList.toggle('hover:bg-gray-900', !btnPrev.disabled)
    btnNext.classList.toggle('disable-button', btnNext.disabled)
    btnNext.classList.toggle('hover:bg-gray-900', !btnNext.disabled)

    const pStart = document.querySelector('#paginationStart')
    const pEnd = document.querySelector('#paginationEnd')
    const pTotal = document.querySelector('#totalPagination')
    pStart.innerHTML = currentStart + 1 // para que no muestre "0"
    pEnd.innerHTML = Math.min(currentEnd, data.length)
    pTotal.innerHTML = data.length
  }

  async function renderPage(currentData = data) {
      const tableContent = document.querySelector('#tbody')
      tableContent.innerHTML = ""
      let profesores = []

      try {
        const resProfesores = await fetch('http://localhost:4000/api/curso/profesores-con-cursos',{
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          }}
        )
        const dataProfesores = await resProfesores.json()
        profesores = dataProfesores.body
        console.log(profesores)

      } catch (error) {
        console.error(error)
      }

      const paginated = currentData.slice(currentStart, currentEnd)

      paginated.forEach(item => {
        const tr = document.createElement('tr')

        const profesorEncontrado = profesores.find(prof => prof.id_curso === item.id)

        tr.innerHTML = `
          <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 text-left text-sm font-bold text-xs">${item.nombre}</td>
          <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${profesorEncontrado? (profesorEncontrado.nombre_profesor + ' ' + profesorEncontrado.apellido_profesor) : 'No asignado'}</td>
          <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.descripcion}</td>
          <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.grado_academico}</td>
          <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.duracion}</td>
          <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 text-xs whitespace-nowrap p-4">
            <button id='verInscriptos' class="rounded-3xl bg-blue-700 text-white w-24 h-6" data-id="${item.id}">
              Ver inscriptos
            </button>
            <button class="rounded-3xl bg-red-600 w-6 h-6 eliminarCurso" data-id="${item.id}">
              <i class="fa-solid fa-xmark" style="color: #000000;"></i>
            </button>
          </td>
        `

        tableContent.appendChild(tr)
        const btn = tr.querySelector('.eliminarCurso')

        btn.addEventListener('click', async () => {
          const cursoId = btn.getAttribute('data-id')
          try {
            const response = await fetch('http://localhost:4000/api/curso', {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({ id: cursoId })
            })

            if (!response.ok) {
              throw new Error('Error al eliminar el curso')
            }

            await loadData()
            ModalConfirmacion(true)
          } catch (error) {
            ModalConfirmacion(false)
            console.error(error)
          }
        })
      })
      checkButton()
  }

// Busqueda por dni
const inputSearchName = document.querySelector('#search-by-name')
const selectSearchType = document.querySelector('#search-type')
inputSearchName.addEventListener('input', async () => {
  const filtro = inputSearchName.value.trim().toLowerCase()
  const tipo = selectSearchType.value
  currentStart = 0

  if (filtro === "") {
    renderPage()
  } else {
    let profesores = []
    try {
      const resProfesores = await fetch('http://localhost:4000/api/curso/profesores-con-cursos', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        }
      })
      const dataProfesores = await resProfesores.json()
      profesores = dataProfesores.body
    } catch (error) {
      console.error(error)
    }

    let filtrados = []

    if (tipo === "nombre") {
      filtrados = data.filter(item => item.nombre.toLowerCase().includes(filtro))
    } else if (tipo === "profesor") {
      filtrados = data.filter(item => {
        const prof = profesores.find(p => p.id_curso === item.id)
        const nombreProfesor = prof ? `${prof.nombre_profesor} ${prof.apellido_profesor}`.toLowerCase() : ""
        return nombreProfesor.includes(filtro)
      })
    }

    renderPage(filtrados)
  }
})

document.querySelector('#download-csv')?.addEventListener("click", async () => {
  downloadCsv(data,'tabla-cursos-activos')
});

document.getElementById('agregar-nuevo-curso').addEventListener('click',()=>{
  const modal = document.createElement('DIV')
  modal.innerHTML = `
      <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
        <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
          <h2 class="text-xl font-semibold text-gray-800">Agregar nuevo curso</h2>
          <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">Nombre del curso</label>
          <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="nombre" type="text">
          <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">Grado academico proporcionado</label>
          <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="gradoAcademico" type="text">
          <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">Descripción</label>
          <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="descripcion" type="text">
          <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-occupation">Duración</label>
          <input class="  appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="duracion" type="text">
          <div class="flex justify-end gap-2">
            <button id="agregarCurso" class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-500">Calificar</button>
            <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Cancelar</button>
          </div>
        </div>
      </div>`
  document.body.appendChild(modal)
  document.getElementById('cancelarModal').addEventListener('click',()=>modal.remove())
  document.getElementById('agregarCurso').addEventListener('click',async ()=>{    
      let error = 0

      const name = document.getElementById("nombre")
      const academicDegree = document.getElementById("gradoAcademico")
      const description = document.getElementById("descripcion")
      const duration = document.getElementById("duracion")

      Notification.prototype.deletePreviousNotification()


      error += validation.checkInputAlphaNumeric(name, 4, 50)
      error += validation.checkInputAlphaNumeric(academicDegree,4,20)
      error += validation.checkInputAlphaNumeric(description, 4, 100)
      error += validation.checkInputAlphaNumeric(duration,4,10)

      if (error === 0) {
        const json = {
          nombre: name.value,
          grado_academico: academicDegree.value,
          descripcion: description.value,
          duracion: duration.value
        }

        try {

          const response = await fetch("http://localhost:4000/api/curso", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(json)
          })

          if (!response.ok) throw new Error("Error al enviar los datos")
          modal.remove()
          loadData()
          ModalConfirmacion(true)
        } catch (error) {
          modal.remove()
          ModalConfirmacion(false)
        }
  }})

})

document.getElementById('agregar-profesor-curso').addEventListener('click', async ()=>{
  let cursosDisponibles = []
  let profesoresDisponibles = []

  try {
    // Traer cursos
    const resCursos = await fetch("http://localhost:4000/api/curso", {
      method: "GET",
      headers: {
        "Content-Type": "application/json",
        'Authorization': `Bearer ${token}`
      }
    })
    const jsonCursos = await resCursos.json()
    cursosDisponibles = jsonCursos.body

    // Traer personal
    const resPersonal = await fetch("http://localhost:4000/api/personal", {
      method: "GET",
      headers: {
        "Content-Type": "application/json",
        'Authorization': `Bearer ${token}`
      }
    })
    const jsonPersonal = await resPersonal.json()
    profesoresDisponibles = jsonPersonal.body.filter(persona => persona.ocupacion.toLowerCase() === "profesor")

  } catch (error) {
    console.error("Error al obtener cursos o profesores", error)
  }

  // Crear modal
  const modal = document.createElement('DIV')
  modal.innerHTML = `
      <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
        <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
          <h2 class="text-xl font-semibold text-gray-800">Asignar profesor al curso</h2>
          <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2">Seleccionar curso</label>
          <select id="select-curso-modal" class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none">
            <option value="" disabled selected>Seleccionar curso</option>
            ${cursosDisponibles.map(curso => `<option value="${curso.id}">${curso.nombre}</option>`).join('')}
          </select>
          <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2">Seleccionar profesor</label>
          <select id="select-profesor-modal" class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none">
            <option value="" disabled selected>Seleccionar profesor</option>
            ${profesoresDisponibles.map(profesor => `<option value="${profesor.id}">${profesor.nombre} ${profesor.apellido}</option>`).join('')}
          </select>
          <div class="flex justify-end gap-2">
            <button id="asignarProfesor" class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-500">Agregar</button>
            <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Cancelar</button>
          </div>
        </div>
      </div>`
  document.body.appendChild(modal)

  document.getElementById('cancelarModal').addEventListener('click',()=> modal.remove())
  
  document.getElementById('asignarProfesor').addEventListener('click', async ()=>{
    const cursoId = document.getElementById("select-curso-modal").value
    const profesorId = document.getElementById("select-profesor-modal").value

    if (!cursoId || !profesorId) {
      alert("Debe seleccionar un curso y un profesor")
      return
    }

    try {
      const response = await fetch("http://localhost:4000/api/curso/asignar-personal", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          id_personal: profesorId,
          id_curso: cursoId
        })
      })

      if (!response.ok) throw new Error("Error al asignar el profesor")
      await loadData()
      modal.remove()
      ModalConfirmacion(true)
    } catch (error) {
      modal.remove()
      ModalConfirmacion(false)
    }
  })
})

document.getElementById('tbody').addEventListener('click', async (e) => {
  if (e.target && e.target.id === 'verInscriptos') {
    const cursoId = e.target.getAttribute('data-id')

    try {
      const res = await fetch('http://localhost:4000/api/curso/alumnos-por-curso', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ idCurso: cursoId })
      })
      const json = await res.json()
      let alumnos = json.body
      console.log(alumnos)

      // Filtrar solo los que están cursando
      alumnos = alumnos.filter(alumno => alumno.estado_terminacion === 'cursando')

      // Obtener años únicos
      const anios = [...new Set(alumnos.map(a => a.anio))]

      // Crear modal
      const modal = document.createElement('DIV')
      modal.innerHTML = `
        <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
          <div class="bg-white p-6 rounded-xl w-full max-w-lg shadow-lg relative">
            <h2 class="text-xl font-semibold text-gray-800 mb-4 text-center">Alumnos inscriptos</h2>
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2">Filtrar por año</label>
            <select id="select-anio-inscriptos" class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-2 px-3 mb-4 leading-tight focus:outline-none">
              <option value="">Todos los años</option>
              ${anios.map(anio => `<option value="${anio}">${anio}</option>`).join('')}
            </select>
            <div id="listado-alumnos" class="space-y-2 max-h-60 overflow-y-auto"></div>
            <div class="flex justify-end mt-4">
              <button id="cerrarModal" class="px-4 py-2 bg-red-500 hover:bg-red-700 text-white rounded">Cerrar</button>
            </div>
          </div>
        </div>
      `
      document.body.appendChild(modal)

      const listado = modal.querySelector('#listado-alumnos')

      function renderListado(lista) {
        listado.innerHTML = lista.length > 0
          ? lista.map(a => `
              <div class="border p-2 rounded bg-gray-100 text-sm">
                <strong>${a.nombre.trim()} ${a.apellido.trim()}</strong> — DNI: ${a.dni}
              </div>
            `).join('')
          : '<p class="text-center text-gray-500 text-sm">No hay alumnos en este año.</p>'
      }


      renderListado(alumnos)

      document.getElementById('select-anio-inscriptos').addEventListener('change', (e) => {
        const selectedYear = e.target.value
        const filtrados = selectedYear ? alumnos.filter(a => String(a.anio) === selectedYear) : alumnos
        renderListado(filtrados)
      })

      document.getElementById('cerrarModal').addEventListener('click', () => modal.remove())
    } catch (error) {
      console.error("Error al obtener alumnos inscriptos", error)
    }
  }
})


function ModalConfirmacion(estado){
  const modalConfirmacion = document.createElement('DIV')
  modalConfirmacion.innerHTML = `
    <div id="modal-confirmacion" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg flex flex-col items-center space-y-4 relative">
        <h2 class="text-lg font-semibold text-gray-800 text-center">${estado? 'Guardado con éxito': 'Error al guardar'}</h2>
        <button id="cerrar" class="px-4 py-2 ${estado? 'bg-green-700 hover:bg-green-600': 'bg-red-700 hover:bg-red-600'} text-white rounded">Aceptar</button>
      </div>
    </div>`
  document.body.appendChild(modalConfirmacion)
  document.getElementById('cerrar').addEventListener('click', () => modalConfirmacion.remove())
}

</script>