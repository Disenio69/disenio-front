---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title="Gestión de inscripciones" path='Gestión de inscripciones' pageTitle='Gestión de inscripciones'>
  <div class="flex items-center space-x-4 ml-10">
    <a class="rounded-3xl bg-blue-700 px-10 py-1.5 text-white text-lg" href="/inscribir-alumno">Inscribir alumno</a>
    <div class="relative w-[250px]">
      <select id="select-anio" class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg">
        <option value="">Todos los años</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>
    <div class="relative w-[250px]">
      <select id="select-curso" class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg">
        <option value="">Todos los cursos</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>
    <div class="relative w-[250px]">
      <select id="select-estado" class="appearance-none w-full leading-tight focus:outline-none rounded-3xl border-2 border-gray-700 px-8 py-1.5 text-black text-lg pr-10 shadow-lg">
        <option value="">Todos los estados</option>
        <option value="cursando">Cursando</option>
        <option value="egresado">Egresado</option>
        <option value="desaprobado">Desaprobado</option>
        <option value="abandonado">Abandonodo</option>
      </select>
      <i class="fa-solid fa-angle-down absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-black"></i>
    </div>


  </div>
  <span class="float-right mr-14 mb-2">
    <span class="text-sm text-gray-700">Descargar como:</span>
    <i id="download-csv" class="fa-solid fa-file-csv fa-xl cursor-pointer text-[color:#217346] hover:text-green-800 transition-colors duration-200 ml-2" title="Descargar CSV"></i>
  </span>
  <!-- Tabla -->
  <div id="mainDiv" class="mt-5 pb-5">
    <div class="xl:w-full px-10">
      <div class="flex flex-col min-w-0 bg-white w-full shadow-lg rounded mb-5">
        <div class="rounded-t mb-0 px-4 py-3 border-0">
          <div class="flex flex-wrap items-center">
            <div class="relative w-full px-2 flex-grow flex-1">
              <h3 class="font-semibold text-base text-blueGray-700">Lista de alumnos</h3>
            </div>
            <div class="relative flex-grow flex-1 sm:text-right">
              <input id="search-by-dni" class="border-2 border-black text-black text-xs font-bold px-7 py-1 rounded-full" type="text" placeholder="Buscar por dni">
              <i class="relative md:visible invisible top-0.5 right-48 fa-solid fa-magnifying-glass" style="color: #000000;"></i>
            </div>
          </div>
        </div>
        <div class="block w-full overflow-x-auto">
          <table class="items-center bg-transparent w-full border-collapse">
            <thead>
              <tr>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">DNI</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Nombre</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Apellido</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Año</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Curso</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Estado</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 border border-solid py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Opciones</th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-sm text-gray-700">Mostrando <span id="paginationStart"></span> de <span id="paginationEnd"></span> de <span id="totalPagination"></span> entradas</span>
        <div class="inline-flex mt-2">
          <button id="previousPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 rounded-s hover:bg-gray-900">Anterior</button>
          <button id="nextPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 border-s hover:bg-gray-900">Siguiente</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .disable-button {
  opacity: 0.5;
  cursor: not-allowed;
}
</style>

<script>//@ts-nocheck
import { downloadCsv } from '../components/downloadTable'
import { moreInfoRow } from '../components/moreInfoRow'

let data = []
let filteredData = []
const limitcolums = 5
let currentStart = 0
let currentEnd = currentStart + limitcolums
const token = localStorage.getItem('token')

const selectAnio = document.getElementById('select-anio')
const selectCurso = document.getElementById('select-curso')

async function fetchData() {
  const response = await fetch('http://localhost:4000/api/curso/alumnos-cursos', {
    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }
  })
  const json = await response.json()
  let rawData = json.body

  data = rawData

  // Poblar select de años
const anios = [...new Set(data.map(d => parseInt(d.anio)))].sort((a, b) => b - a)
anios.forEach(anio => {
  const opt = document.createElement('option')
  opt.value = anio
  opt.textContent = anio
  selectAnio.appendChild(opt)
})


  // Poblar select de cursos
  const cursos = [...new Set(data.map(d => d.curso_nombre))]
  cursos.forEach(curso => {
    const opt = document.createElement('option')
    opt.value = curso
    opt.textContent = curso
    selectCurso.appendChild(opt)
  })

  filteredData = [...data]
}

function filtrarDatos() {
  const selectedAnio = selectAnio.value
  const selectedCurso = selectCurso.value
  const selectedEstado = selectEstado.value

  filteredData = data

  if (selectedAnio) {
    filteredData = filteredData.filter(item => String(item.anio) === selectedAnio)
  }

  if (selectedCurso) {
    filteredData = filteredData.filter(item => item.curso_nombre === selectedCurso)
  }

  if (selectedEstado) {
    filteredData = filteredData.filter(item => item.estado_terminacion === selectedEstado)
  }

  currentStart = 0
  currentEnd = currentStart + limitcolums
  renderPage()
}


function renderPage(currentData = filteredData) {
  const tbody = document.getElementById('tbody')
  tbody.innerHTML = ""

  const paginated = currentData.slice(currentStart, currentEnd)

  paginated.forEach(item => {
    const tr = document.createElement('tr')
    tr.innerHTML = `
      <td class="border-t-0 px-6 p-4 text-left text-sm font-bold text-xs">${item.dni}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.nombre}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.apellido}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.anio}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.curso_nombre}</td>
      <td class="border-t-0 px-6 p-4 font-bold text-xs">${item.estado_terminacion}</td>
      <td class="border-t-0 px-6 p-4">
        <button class="rounded-3xl bg-red-600 w-6 h-6 eliminarCurso" 
                data-alumno-id="${item.id_alumno}" 
                data-curso-id="${item.id_curso}" 
                data-anio="${item.anio}">
          <i class="fa-solid fa-xmark" style="color: #000000;"></i>
        </button>
      </td>
`

    tbody.appendChild(tr)
  })

  // Botones eliminar
  const botonesEliminar = document.querySelectorAll('.eliminarCurso')
  botonesEliminar.forEach(btn => {
    btn.addEventListener('click', () => {
      ModalConfirmarEliminacion(async () => {
        const idAlumno = btn.getAttribute('data-alumno-id')
        const idCurso = btn.getAttribute('data-curso-id')
        const anio = btn.getAttribute('data-anio')

        try {
          const res = await fetch('http://localhost:4000/api/curso/quitar-alumno', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ id_alumno: idAlumno, id_curso: idCurso, anio: anio })
          })

          if (!res.ok) {
            throw new Error('Error al quitar alumno')
          }

          await fetchData()
          filtrarDatos()
        } catch (error) {
          console.error(error)
        }
      })
    })
  })

  checkButton()
}

function checkButton() {
  const btnPrev = document.getElementById('previousPage')
  const btnNext = document.getElementById('nextPage')

  btnPrev.disabled = currentStart === 0
  btnNext.disabled = currentStart + limitcolums >= filteredData.length

  if (btnPrev.disabled) {
    btnPrev.classList.add('disable-button')
    btnPrev.classList.remove('hover:bg-gray-900')
  } else {
    btnPrev.classList.remove('disable-button')
    btnPrev.classList.add('hover:bg-gray-900')
  }

  if (btnNext.disabled) {
    btnNext.classList.add('disable-button')
    btnNext.classList.remove('hover:bg-gray-900')
  } else {
    btnNext.classList.remove('disable-button')
    btnNext.classList.add('hover:bg-gray-900')
  }

  document.getElementById('paginationStart').textContent = currentStart + 1
  document.getElementById('paginationEnd').textContent = Math.min(currentEnd, filteredData.length)
  document.getElementById('totalPagination').textContent = filteredData.length
}

document.getElementById('nextPage').addEventListener('click', () => {
  if (currentStart + limitcolums < filteredData.length) {
    currentStart += limitcolums
    currentEnd = Math.min(currentStart + limitcolums, filteredData.length)
    renderPage()
  }
})

document.getElementById('previousPage').addEventListener('click', () => {
  if (currentStart - limitcolums >= 0) {
    currentStart -= limitcolums
    currentEnd = currentStart + limitcolums
    renderPage()
  }
})

selectAnio.addEventListener('change', () => {
  filtrarDatos()
})

selectCurso.addEventListener('change', () => {
  filtrarDatos()
})

document.getElementById('search-by-dni').addEventListener('input', e => {
  const filtro = e.target.value.trim()
  currentStart = 0
  currentEnd = currentStart + limitcolums

  if (!filtro) {
    renderPage()
  } else {
    const filtrados = filteredData.filter(item => String(item.dni).startsWith(filtro))
    renderPage(filtrados)
  }
})

document.getElementById('download-csv').addEventListener('click', () => {
  downloadCsv(filteredData, 'tabla-estudiantes-inscriptos')
})

document.addEventListener('DOMContentLoaded', async () => {
  await fetchData()
  renderPage()
})

function ModalConfirmarEliminacion(onConfirm) {
  const modalExistente = document.getElementById('modal-confirmar')
  if (modalExistente) modalExistente.remove()

  const modal = document.createElement('DIV')
  modal.id = 'modal-confirmar'
  modal.innerHTML = `
    <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg flex flex-col items-center space-y-4 relative">
        <h2 class="text-lg font-semibold text-gray-800 text-center">¿Estás seguro de eliminar esta asignación?</h2>
        <div class="flex gap-4">
          <button id="confirmarEliminar" class="px-4 py-2 bg-red-700 hover:bg-red-600 text-white rounded">Eliminar</button>
          <button id="cancelarEliminar" class="px-4 py-2 bg-gray-400 hover:bg-gray-500 text-white rounded">Cancelar</button>
        </div>
      </div>
    </div>
  `
  document.body.appendChild(modal)

  const btnConfirmar = document.getElementById('confirmarEliminar')
  const btnCancelar = document.getElementById('cancelarEliminar')

  btnConfirmar.addEventListener('click', () => {
    modal.remove()
    if (typeof onConfirm === 'function') onConfirm()
  })

  btnCancelar.addEventListener('click', () => {
    modal.remove()
  })
}

const selectEstado = document.getElementById('select-estado')
selectEstado.addEventListener('change', () => {
  filtrarDatos()
})


</script>
