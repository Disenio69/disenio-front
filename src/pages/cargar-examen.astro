---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---
<DashboardLayout title='Cargar examén' path='Cargar examén' pageTitle='Cargar examén'>
    <form id="form-classroom-schedule" class="w-full pl-16 pr-16 mt-6">
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-schedule-start">
                    Curso
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-schedule-start" type="text">
            </div>
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-schedule-start">
                    DNI estudiante
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-schedule-start" type="text">
            </div>
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-schedule-end">
                    Cargar scan del examén
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-schedule-end" type="text" value="Aqui deberia haber una ventana para cargar el scan tipo pdf del examen">
            </div>
        </div>
        <div class="flex items-center ml-3">
            <button id="form-classroom-schedule" class="bg-blue-500 hover:bg-blue-700 focus:outline-none focus:shadow-outline text-white font-bold py-2 px-4 rounded " type="submit">
              Cargar examén y seguir
            </button>
            <button id="form-classroom-schedule" class="bg-gray-700 hover:bg-gray-600 focus:outline-none focus:shadow-outline text-white font-bold py-2 px-4 ml-10 rounded " type="submit">
              Cargar examén y salir
            </button>
            <a class="bg-white text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer ml-10" href="/gestion-aulas-y-horarios">
                Cancelar
            </a>
          </div>
      </form>
</DashboardLayout>

