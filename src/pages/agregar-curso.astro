---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title='Agregar un nuevo curso' path='Agregar un nuevo curso' pageTitle='Agregar un nuevo curso'>
    <form id="form-user-add" class="w-full pl-16 pr-16 mt-6">      
      <div class="flex flex-wrap md:w-1/3 mx-3 mb-6">
          <div class="w-full px-3 mb-6">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-firshName">
              Nombre del curso
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-firstName" type="text" placeholder="Carpinteria">
          </div>
          
          <div class="w-full px-3 mb-6">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-lastName">
              Grado academico
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-lastName" type="text" placeholder="Carpintero">
          </div>

          <div class="w-full px-3 mb-6">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-birthday">
              DNI del profesor a cargo
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-birthday" type="text" onkeydown="return false;" placeholder="43234234">
          </div>
          
          <div class="w-full px-3 mb-6">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-dni">
              descripción
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-dni" type="text" placeholder="Licenciatura en carpinteria de maderas blanca">
          </div>

          <div class="w-full px-3 mb-6">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-user">
              Duración
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-user" type="text" placeholder="1 año">
          </div>
        </div>
        <div class="flex items-center ml-6">
            <button id="form-submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded " type="submit">
              Agregar usuario
            </button>
            <a class="bg-white text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer ml-20" href="/gestion-de-usuarios">
                Cancelar
              </a>
          </div>
      </form>
</DashboardLayout>

