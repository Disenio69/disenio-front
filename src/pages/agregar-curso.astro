---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title='Cargar un nuevo usuario' path='Agregar nuevo usuario' pageTitle='Agregar nuevo usuario'>
    <form id="form-course-add" class="w-full pl-16 pr-16 mt-6">   
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-name">
                    Nombre del curso
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-name" type="text">
            </div>
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-academic-degree">
                    Grado academico proporcionado
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-academic-degree" type="text">
            </div>
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-description">
                    Descripción
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-description" type="text">
            </div>
              <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-duration">
                    Duración
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-duration" type="text">
            </div>
        <div class="flex items-center ml-6">
            <button id="form-submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded " type="submit">
                Agregar usuario
            </button>
            <a class="bg-white text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer ml-20" href="/estudiantes-inscriptos">
                Cancelar
            </a>
        </div>
    </form>
</DashboardLayout>

<script>
  import { Notification } from "../components/notifications.js"
  import * as validation from "../components/validations.ts"
  import { showModal } from '../components/modal.js'

  let dataStudent: { id: number, dni: number }[] = []
  let dataClass: { id: number, nombre: string }[] = []
  const token = localStorage.getItem('token')

  document.addEventListener("DOMContentLoaded", async () => {
    const form = document.querySelector("#form-course-add") as HTMLFormElement
    if (form) {
      form.addEventListener("submit", async function (event) {
        event.preventDefault()

        let error = 0

        const name = document.querySelector("#input-name") as HTMLInputElement
        const academicDegree = document.querySelector("#input-academic-degree") as HTMLInputElement
        const description = document.querySelector("#input-description") as HTMLInputElement
        const duration = document.querySelector("#input-duration") as HTMLInputElement

        Notification.prototype.deletePreviousNotification()

        error += validation.checkInputLetters(name, 4, 50)
        error += validation.checkInputLetters(academicDegree,4,20)
        error += validation.checkInputLetters(description, 4, 100)
        error += validation.checkInputAlphaNumeric(duration,4,10)

        if (error === 0) {
          const formData = {
            nombre: name.value,
            grado_academico: academicDegree.value,
            descripcion: description.value,
            duracion: duration.value
          }

          try {

            const response = await fetch("http://localhost:4000/api/curso", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify(formData)
            })

            if (!response.ok) throw new Error("Error al enviar los datos")

            showModal("Curso agregado con éxito", "Éxito")

            form.reset()
          } catch (error) {
            showModal("Error: " + (error instanceof Error ? error.message : String(error)), 'Error')
          }
        }
      })
    }
  })
</script>
