<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="../../public/img/favicon.png">
    <link href='https://fonts.googleapis.com/css?family=Lato:400,700' rel='stylesheet' type='text/css'>
    <script src="https://kit.fontawesome.com/aef010b255.js" crossorigin="anonymous"></script>
    <title>Iniciar sesión</title>
  </head>
  <body class="w-p m-auto mt-60 bg-cyan-200">
    <main>
      <section class="w-full rounded-6 shadow-2xl p-10 bg-white">
        <form class="rounded px-8 pt-6 pb-8 mb-4">
          <div class="mb-8">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="mail">Correo</label>
            <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="mail" type="text" placeholder="juan@gmail.com">
          </div>
          <div class="mb-4" id="notification">
            <label class="block text-gray-700 text-sm font-bold mb-2" for="password">Contraseña</label>
            <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="password" type="password" placeholder="*************">
          </div>
          <div class="flex items-center justify-around pt-5 pb-5">
            <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="button">
              Iniciar sesión
            </button>
            <a class="text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer" href="/examenes-y-materias">
              Olvidé mi contraseña
            </a>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>

<style>
  .w-p {
    width: 500px;
  }
</style>

<script>
  //@ts-nocheck
  import * as validation from "../components/validations.ts"
  import { Notification } from "../components/notifications.js"

  const loginBtn = document.querySelector('button')
  const email = document.getElementById('mail')
  const password = document.getElementById('password')
  const mainContainer = document.getElementById('notification')

  loginBtn.addEventListener('click', async () => {
    Notification.prototype.deletePreviousNotification()

    const correo = email.value.trim()
    const contrasena = password.value.trim()
    let error = 0
    error += validation.checkInputEmail(email, 6, 254)
    error += validation.checkInputPassword(password, 4, 20)

    if (error === 0) {
      try {
        const res = await fetch('http://localhost:4000/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ correo, contrasena })
        })

        const data = await res.json()

        if (!res.ok) {
          throw new Error(data.body || 'Error desconocido')
        }

        const token = data.body.token
        const usuario = data.body.usuario

        if (!token) throw new Error('No se recibió token del backend')
        if (!usuario) throw new Error('No se recibió información del usuario')

        localStorage.setItem('token', token)

        if(usuario.ocupacion){
          if (usuario.ocupacion.toLowerCase() === 'profesor' || usuario.ocupacion.toLowerCase() === 'administrador') {
            window.location.href = '/inicio-dashboard'
          } else {
            if(usuario.ocupacion.toLowerCase() === 'alumno'){
              window.location.href = '/inicio'
            }
            else{
              window.location.href = '/error'
            }
            
          }
        }
      } catch (err) {
        if (err instanceof Error) {
          new Notification(`Ocurrió un error durante la autenticación. Intentelo de nuevo. Error: ${err.message}`, 'error', mainContainer)
        } else {
          new Notification("Error desconocido al autenticar", 'error', mainContainer)
        }
      }
    }
  })
</script>
