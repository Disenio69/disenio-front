---
import MoodleLayout from "../layouts/Moodle-Layout.astro";
---

<MoodleLayout title="Inicio">
	<!-- Últimas calificaciones -->
    <section id="pracSection" class="w-full bg-white p-4 rounded-2xl shadow">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold">Últimas notas de trabajos practicos</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b">
              <th class="py-2">Materia</th>
              <th class="py-2">Archivo</th>
              <th class="py-2">Nota</th>
            </tr>
          </thead>
          <tbody id="tbodyTps">
            
          </tbody>
        </table>
      </div>
    </section>

      <section id="examSection" class="w-full bg-white p-4 rounded-2xl shadow">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold">Últimas notas de examenes</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b">
              <th class="py-2">Materia</th>
              <th class="py-2">Examen</th>
              <th class="py-2">Nota</th>
            </tr>
          </thead>
          <tbody id="tbodyExamen">
            
          </tbody>
        </table>
      </div>
      <div class="text-center mt-4">
      </div>
    </section>
    

    <!-- Carrusel -->
    <section class="w-full bg-white p-4 rounded-2xl shadow">
		<h2 class="text-xl font-semibold">Viste general de cursos</h2>
    <div id="contenedor-cursos" class="flex flex-wrap gap-6 mt-6">
      <!-- Elementos -->
    </div>
    </section>
</MoodleLayout>

<script>
//@ts-nocheck
import { TypeFlags } from "typescript"
let payload = {}
//@ts-nocheck
const token = localStorage.getItem('token')
addEventListener('DOMContentLoaded',()=>{

  const base64Url = token.split('.')[1]
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
  }).join(''))
  payload = JSON.parse(jsonPayload)

  const disPrac = document.getElementById('pracSection')
  disPrac.classList.add('hidden')
  const disExam = document.getElementById('examSection')
  disExam.classList.add('hidden')

  cargarCursos()
  cargarMateriales()
})

async function cargarCursos(){
  let data = []
  data = await obtenerCursos(data)
  mostrarCursos(data)
  
}
async function cargarMateriales(){
    await cargarTrabajosPracticos()
    await cargarExamen()
}

async function cargarTrabajosPracticos(){
  const tbodyTps = document.getElementById('tbodyTps')
  tbodyTps.innerHTML = ''

  try {
    const resAlumnoMaterial = await fetch(`http://localhost:4000/api/material/alumno/${payload.id}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if (!resAlumnoMaterial.ok) {
      console.error("Error fetch")
      return
    }

    const jsonAlumnoMaterial = await resAlumnoMaterial.json()
    let data = jsonAlumnoMaterial.body

    // ✅ Filtrar para solo mostrar las últimas 5
    if (data.length > 5) {
      data = data.slice(-5) // toma las últimas 5 (del final)
    }

    data.forEach(tps => {
      if(tps.tipo !== 'examen'){
        const tr = document.createElement('tr')
        tr.classList.add('border-b')

        const tdMateria = document.createElement('td')
        tdMateria.classList.add('py-2')
        tdMateria.textContent = tps.nombre_materia

        const tdObs = document.createElement('td')
        tdObs.classList.add('py-2')
        tdObs.textContent = tps.observacion

        const tdNota = document.createElement('td')
        tdNota.classList.add('py-2')
        tdNota.textContent = tps.calificacion

        tr.appendChild(tdMateria)
        tr.appendChild(tdObs)
        tr.appendChild(tdNota)
        tbodyTps.appendChild(tr)
      }
      
    })

  } catch (error) {
    console.error(error)
  }
}

async function cargarExamen(){
  const tbodyTps = document.getElementById('tbodyExamen')
  tbodyTps.innerHTML = '' 

  try {
    const resAlumnoExamen = await fetch(`http://localhost:4000/api/material/alumno/${payload.id}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if (!resAlumnoExamen.ok) {
      console.error("Error fetch")
      return
    }

    const jsonAlumnoExamen = await resAlumnoExamen.json()
    let data = jsonAlumnoExamen.body

    // ✅ Filtrar para solo mostrar las últimas 5
    if (data.length > 5) {
      data = data.slice(-5) // toma las últimas 5 (del final)
    }

    data.forEach(examen => {
      if(examen.tipo === 'examen'){
        const tr = document.createElement('tr')
        tr.classList.add('border-b')

        const tdMateria = document.createElement('td')
        tdMateria.classList.add('py-2')
        tdMateria.textContent = examen.nombre_materia

        const tdObs = document.createElement('td')
        tdObs.classList.add('py-2')
        tdObs.textContent = examen.observacion

        const tdNota = document.createElement('td')
        tdNota.classList.add('py-2')
        tdNota.textContent = examen.calificacion

        tr.appendChild(tdMateria)
        tr.appendChild(tdObs)
        tr.appendChild(tdNota)
        tbodyTps.appendChild(tr)
      }
    })

  } catch (error) {
    console.error(error)
  }
}


function mostrarCursos(data){
  const contenedor = document.getElementById('contenedor-cursos')
  contenedor.innerHTML = ''
  data.forEach(elemento => {
    contenedor.innerHTML += `
    <a href="http://localhost:4321/cursos/${elemento.id}" class="max-w-[362px] rounded-t-2xl border shadow bg-white basis-1/3 hover:shadow-md">
        <div class="h-32 bg-gradient-to-r from-blue-100 to-blue-200 rounded-t-2xl"></div>
        <div class="p-4">
            <h3 class="font-semibold text-gray-700 group-hover:text-blue-600 transition">${elemento.nombre}</h3>
        </div>
    </a>
`
  });
}

async function obtenerCursos(data){

  if(payload.ocupacion === 'alumno'){
    const resCursosAlumno = await fetch(`http://localhost:4000/api/curso/alumno/${payload.id}/cursos`,{
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if(!resCursosAlumno){
      console.log("Error fetch de cursos del alumno")
    }
    
    const jsonCursosAlumno = await resCursosAlumno.json()
    data = jsonCursosAlumno.body
  }

  if(payload.ocupacion === 'profesor'){
    const resCursosProf = await fetch(`http://localhost:4000/api/curso/personal/${payload.id}/cursos`,{
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    if(!resCursosProf){
      console.log("Error fetch de cursos del profesor")
    }
    
    const jsonCursosProf = await resCursosProf.json()
    data = jsonCursosProf.body
  }

  return data
}

</script>