---
import MoodleLayout from "../layouts/Moodle-Layout.astro";


---

<MoodleLayout title="Inicio">
	<!-- Últimas calificaciones -->
    <section class="w-full bg-white p-4 rounded-2xl shadow">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold">Últimas calificaciones</h2>
        <select class="border px-3 py-1 rounded text-sm">
          <option>Trabajos prácticos</option>
        </select>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b">
              <th class="py-2">Materia</th>
              <th class="py-2">Descripción u observación</th>
              <th class="py-2">Nota</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <td class="py-2">Matemáticas</td>
              <td class="py-2">Descripción u observación</td>
              <td class="py-2">10.10</td>
            </tr>
            <tr class="border-b">
              <td class="py-2">Materia 2</td>
              <td class="py-2">Descripción u observación</td>
              <td class="py-2">10.10</td>
            </tr>
            <tr class="border-b">
              <td class="py-2">Materia 3</td>
              <td class="py-2">Descripción u observación</td>
              <td class="py-2">10.10</td>
            </tr>
            <tr class="border-b">
              <td class="py-2">Materia 4</td>
              <td class="py-2">Descripción u observación</td>
              <td class="py-2">10.10</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="text-center mt-4">
        <button class="text-gray-600 text-sm hover:underline">Ver más ⌄</button>
      </div>
    </section>

    <!-- Carrusel -->
    <section class="w-full bg-white p-4 rounded-2xl shadow">
		<h2 class="text-xl font-semibold">Viste general de cursos</h2>
		<!-- Elemento -->
		<div class="flex gap-6 overflow-hidden mt-6">
			<div class="w-100 rounded border shadow overflow-hidden bg-white">
				<div class="h-32 bg-yellow-300"></div>
				<div class="p-4">
					<p class="text-gray-600 text-sm">Ingeniería en Sistemas de Información</p>
					<div class="flex justify-between items-center">
						<h3 class="font-semibold text-gray-800">Teoría de Control</h3>
						<button class="text-gray-500 hover:text-black">⋯</button>
					</div>
				</div>
			</div>
		</div>
    </section>
</MoodleLayout>