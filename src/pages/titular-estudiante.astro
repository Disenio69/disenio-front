---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title='Titular un estudiante' path='Titular estudiante' pageTitle='Titular un estudiante'>
    <form id="form-titulation" class="w-full pl-16 pr-16 mt-6">
      <div class="flex flex-wrap mx-3 mb-6">    
          <div class="w-full md:w-1/3 px-3 mb-6">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-dni">
              DNI
            </label>
            <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-dni" type="text">
          </div>
        </div>
        <div class="flex items-center ml-6">
            <button id="form-submit" class="bg-gray-500 text-white font-bold py-2 px-4 rounded " type="submit">
                Realizar titulacion
            </button>
            <a class="bg-white text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer ml-20" href="/titulacion">
                Cancelar
            </a>
          </div>
      </form>
</DashboardLayout>

