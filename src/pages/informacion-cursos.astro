---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---
<DashboardLayout title="Informacion sobre cursos activos" path='Informacion sobre cursos activos' pageTitle='Informacion sobre cursos activos'>
  <span class="float-right mr-14">
    <span class="text-sm text-gray-700">Descargar como:</span>
    <i id="download-csv" class="fa-solid fa-file-csv fa-xl cursor-pointer text-[color:#217346] hover:text-green-800 transition-colors duration-200 ml-2" title="Descargar CSV"></i>
  </span>

  <div id="mainDiv" class="mt-5 pb-5">
    <div class="xl:w-full px-10">
      <div class="retive flex flex-col min-w-0 break-words bg-white w-full shadow-lg rounded mb-5">
        <div class="rounded-t mb-0 px-4 py-3 border-0">
          <div class="flex flex-wrap items-center">
            <div class="relative w-full px-2 flex-grow flex-1">
              <h3 class="font-semibold text-base text-blueGray-700">Lista de cursos activos</h3>
            </div>
            <div class="relative flex-grow flex-1 sm:text-right">
              <input id="search-by-name" class="border-2 border-black text-black text-xs font-bold px-7 py-1 rounded-full" type="text" placeholder="Buscar por nombre">
              <i class="relative md:visible invisible top-0.5 right-48 fa-solid fa-magnifying-glass" style="color: #000000;"></i>
            </div>
          </div>
        </div>

        <div class="block w-full overflow-x-auto">
          <table class="items-center bg-transparent w-full border-collapse ">
            <thead>
              <tr>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Nombre</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Descripcion</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Inscriptos</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Abandonos</th>
                <th class="px-6 bg-blueGray-50 text-blueGray-500 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase whitespace-nowrap font-semibold text-left">Egresados</th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
      </div>

      <!-- PAGINATION -->
      <div class="flex flex-col items-center">
        <span class="text-sm text-gray-700">Mostrando <span id="paginationStart"></span> a <span id="paginationEnd"></span> de <span id="totalPagination"></span> entradas</span>
        <div class="inline-flex mt-2">
          <button id="previousPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 rounded-s hover:bg-gray-900 disabled:opacity-50" disabled>Anterior</button>
          <button id="nextPage" class="flex items-center justify-center px-3 h-8 text-sm font-medium text-white bg-gray-800 border-s hover:bg-gray-900 disabled:opacity-50" disabled>Siguiente</button>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
//@ts-nocheck 
import { downloadCsv } from '../components/downloadTable'

let data = null
const limitColumns = 5
let currentStart = 0
let currentEnd = currentStart + limitColumns
const token = localStorage.getItem('token')

const btnNext = document.getElementById('nextPage')
const btnPrev = document.getElementById('previousPage')
const tbody = document.getElementById('tbody')
const paginationStart = document.getElementById('paginationStart')
const paginationEnd = document.getElementById('paginationEnd')
const totalPagination = document.getElementById('totalPagination')
const inputSearchName = document.getElementById('search-by-name')

let filteredData = []

document.addEventListener('DOMContentLoaded', () => loadData())

async function fetchData() {
  if (!data) {
    const response = await fetch('http://localhost:4000/api/curso/resumen', {
      headers: { 'Authorization': `Bearer ${token}` }
    })
    const json = await response.json()
    data = json.body
    filteredData = data
  }
  return data
}

async function loadData() {
  data = await fetchData()
  filteredData = data
  renderPage()
}

btnNext.addEventListener('click', () => {
  if (currentStart + limitColumns < filteredData.length) {
    currentStart += limitColumns
    currentEnd = Math.min(currentStart + limitColumns, filteredData.length)
    renderPage()
  }
})

btnPrev.addEventListener('click', () => {
  if (currentStart - limitColumns >= 0) {
    currentStart -= limitColumns
    currentEnd = currentStart + limitColumns
    renderPage()
  }
})

function renderPage() {
  tbody.innerHTML = ""
  const pageData = filteredData.slice(currentStart, currentEnd)

  pageData.forEach(item => {
    tbody.innerHTML += `
      <tr>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 text-left text-sm font-bold text-xs">${item.nombre}</td>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.descripcion}</td>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.inscriptos}</td>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.abandonos}</td>
        <td class="border-t-0 px-6 align-middle border-l-0 border-r-0 whitespace-nowrap p-4 font-bold text-xs">${item.egresados}</td>
      </tr>
    `
  })

  updatePaginationControls()
}

function updatePaginationControls() {
  btnPrev.disabled = currentStart === 0
  btnNext.disabled = currentStart + limitColumns >= filteredData.length

  paginationStart.textContent = filteredData.length === 0 ? 0 : currentStart + 1
  paginationEnd.textContent = Math.min(currentEnd, filteredData.length)
  totalPagination.textContent = filteredData.length
}

inputSearchName.addEventListener('input', () => {
  const search = inputSearchName.value.trim().toLowerCase()
  currentStart = 0
  currentEnd = limitColumns

  if (search === "") {
    filteredData = data
  } else {
    filteredData = data.filter(item => item.nombre.toLowerCase().includes(search))
  }

  renderPage()
})

document.getElementById('download-csv')?.addEventListener("click", async () => {
  downloadCsv(filteredData, 'tabla-cursos-activos')
})
</script>
