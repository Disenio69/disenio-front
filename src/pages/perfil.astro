---
import DashboardLayout from "../layouts/Dashboard-Layout.astro";
---

<DashboardLayout title="Mi perfil" path="Mi perfil" pageTitle="Mi perfil">

<div class="max-w-5xl mx-auto px-6 py-10">
  <div class="bg-white rounded-xl shadow border border-gray-200 p-8 flex flex-col md:flex-row items-center gap-8">
    <div class="relative w-36 h-36 rounded-full overflow-hidden border-4 border-blue-600">
      <img id="imagen-perfil" src="../../public/img/usuario-de-perfil.png" alt="Perfil" class="object-cover w-full h-full transition duration-300 hover:scale-105">
    </div>
    <div class="flex-1 text-center md:text-left">
      <p id="nombre" class="text-2xl font-semibold text-gray-800"></p>
      <p id="ocupacion" class="text-lg text-gray-500 mt-1"></p>
    </div>
  </div>

  <div id="datosPersonales" class="bg-white rounded-xl shadow border border-gray-200 p-8 mt-8">
    <h2 class="text-xl font-bold text-blue-700 mb-4 border-b border-gray-200 pb-2">Datos personales</h2>
  </div>

  <div class="bg-white rounded-xl shadow border border-gray-200 p-8 mt-8 flex flex-col md:flex-row items-center md:justify-between gap-4">
    <h2 class="text-xl font-bold text-blue-700">Configuración</h2>
    <div class="flex flex-col md:flex-row gap-3 w-full md:w-auto">
      <button class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2 rounded-lg transition-all duration-200 shadow-sm hover:shadow-md w-full md:w-auto" id="cambiarDatosPersonales">
        Cambiar información personal
      </button>
      <button class="bg-gray-600 hover:bg-gray-700 text-white font-medium px-5 py-2 rounded-lg transition-all duration-200 shadow-sm hover:shadow-md w-full md:w-auto" id="cambiarContrasenia">
        Cambiar contraseña
      </button>
    </div>
  </div>
</div>

</DashboardLayout>

<script>
//@ts-nocheck
import {checkInputPassword, checkInputLetters, checkInputEmail, checkInputNumbers} from '../components/validations'
import {Notification} from '../components/notifications'

let personal = []
let token = []

addEventListener('DOMContentLoaded', async () => {
  personal = await obtenerProfesor()
  cargarFoto()
  agregarHTML(personal[0])
})

async function obtenerProfesor() {
  token = localStorage.getItem('token')
  const base64Url = token.split('.')[1]
  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
  const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
  }).join(''))
  const payload = JSON.parse(jsonPayload)

  try {
    const res = await fetch(`http://localhost:4000/api/personal/${payload.id}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      }
    })

    const data = await res.json()

    if (!res.ok) {
      console.error('Error al obtener profesor:', data)
      return null
    }

    console.log('Profesor obtenido:', data.body)
    return data.body
  } catch (error) {
    console.error('Error de red:', error)
    return null
  }
}

function agregarHTML(personal) {
  const username = document.getElementById('username')
  if (username) username.textContent = `${personal.nombre} ${personal.apellido}`

  const nombre = document.getElementById('nombre')
  nombre.textContent = `${personal.nombre} ${personal.apellido}`

  const ocupacion = document.getElementById('ocupacion')
  ocupacion.textContent = `${personal.ocupacion}`

  const div = document.createElement('DIV')
  div.classList.add('ml-3')
  div.innerHTML = `
    <p class="text-black text-lg mb-2">Correo: ${personal.correo}</p>
    <p class="text-black text-lg mb-2">DNI: ${personal.dni}</p>
    <p class="text-black text-lg mb-2">Fecha de nacimiento: ${personal.fecha_nacimiento.substring(0, 10)}</p>
    <p class="text-black text-lg mb-2">Teléfono: ${personal.telefono}</p>
  `
  const datosPers = document.getElementById('datosPersonales')
  datosPers?.appendChild(div)
}

document.getElementById('cambiarContrasenia').addEventListener('click', modalCambiarContraseña)
document.getElementById('cambiarDatosPersonales').addEventListener('click', cambiarDatosPersonales)

async function modalCambiarContraseña() {
  const div = document.createElement('DIV')
  div.innerHTML = `
  <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
      <h2 class="text-2xl font-semibold text-black mb-3">Cambiar contraseña</h2>
      <label class="text-black">Contraseña actual</label>
      <input type="password" id="contraseniaActual" class="bg-gray-300 block w-full rounded-lg h-10 pl-2 text-sm text-gray-700">
      <label class="text-black">Nueva contraseña</label>
      <input type="password" id="contraseniaNueva" class="bg-gray-300 block w-full rounded-lg h-10 pl-2 text-sm text-gray-700">
      <div class="flex justify-end gap-2">
        <button id="enviarContrasenia" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Cambiar contraseña</button>
        <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-black rounded hover:bg-gray-700">Cancelar</button>
      </div>
    </div>
  </div>
  `
  document.body.appendChild(div)
  document.getElementById('cancelarModal').addEventListener('click', () => div.remove())

  document.getElementById('enviarContrasenia').addEventListener('click', async () => {
    Notification.prototype.deletePreviousNotification()
    let error = 0
    const contraseniaActual = document.getElementById('contraseniaActual')
    const contraseniaNueva = document.getElementById('contraseniaNueva')
    error += checkInputPassword(contraseniaActual)
    error += checkInputPassword(contraseniaNueva)
    if (error === 0) {
      try {
        const res = await fetch('http://localhost:4000/api/personal/cambiar-contrasena', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            id: personal[0].id,
            actualContrasena: contraseniaActual.value,
            nuevaContrasena: contraseniaNueva.value
          })
        })

        const data = await res.json()

        if (!res.ok) {
          console.error('Error al cambiar contraseña:', data)
          ModalConfirmacion(`Error: ${data.body || 'No se pudo cambiar la contraseña'}`)
          return
        }

        ModalConfirmacion('Contraseña actualizada correctamente')
        div.remove()
      } catch (error) {
        console.error('Error de red:', error)
        ModalConfirmacion('Error de red al cambiar contraseña')
      }
    }
  })
}

async function cambiarDatosPersonales() {
  const div = document.createElement('DIV')
  div.innerHTML = `
  <div id="modal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative">
      <h2 class="text-2xl font-semibold text-black mb-3">Cambiar datos personales</h2>
      <label class="text-black">Nombre:</label>
      <input type="text" id="nombreInput" class="bg-gray-300 block w-full rounded-lg h-10 pl-2 text-sm text-gray-700" value="${personal[0].nombre}">
      <label class="text-black">Apellido:</label>
      <input type="text" id="apellidoInput" class="bg-gray-300 block w-full rounded-lg h-10 pl-2 text-sm text-gray-700" value="${personal[0].apellido}">
      <label class="text-black">Correo electrónico:</label>
      <input type="text" id="correoInput" class="bg-gray-300 block w-full rounded-lg h-10 pl-2 text-sm text-gray-700" value="${personal[0].correo}">
      <label class="text-black">Teléfono:</label>
      <input type="text" id="telefonoInput" class="bg-gray-300 block w-full rounded-lg h-10 pl-2 text-sm text-gray-700" value="${personal[0].telefono}">
      <label class="text-black">Cambiar foto de perfil</label>
      <div class="flex items-center space-x-4">
        <input type="file" id="imagenInput" accept="image/jpeg,image/png,image/webp" class="block w-full rounded-lg border border-gray-300 bg-blue-600 text-white file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:bg-white file:text-blue-600 hover:file:bg-gray-100 transition">
      </div>
      <div class="flex justify-end gap-2">
        <button id="actualizarDatos" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Actualizar datos</button>
        <button id="cancelarModal" class="px-4 py-2 bg-gray-400 text-black rounded hover:bg-gray-700">Cancelar</button>
      </div>
    </div>
  </div>
  `
  document.body.appendChild(div)
  document.getElementById('cancelarModal').addEventListener('click', () => div.remove())

  document.getElementById('actualizarDatos')?.addEventListener('click', async () => {
  const nombreInput = document.getElementById('nombreInput')
  const apellidoInput = document.getElementById('apellidoInput')
  const correoInput = document.getElementById('correoInput')
  const telefonoInput = document.getElementById('telefonoInput')
  const imagenInput = document.getElementById('imagenInput')

  let error = 0
  error += checkInputLetters(nombreInput, 3, 255)
  error += checkInputLetters(apellidoInput, 3, 255)
  error += checkInputEmail(correoInput, 6, 255)
  error += checkInputNumbers(telefonoInput, 6, 20)
  const image = imagenInput.files[0]

  if (error === 0) {
    const body = {
      id: personal[0].id,
      nombre: nombreInput.value,
      apellido: apellidoInput.value,
      correo: correoInput.value,
      telefono: telefonoInput.value
    }

    // Si hay imagen, primero subirla
    if (imagenInput.files.length > 0) {
      const formDataImagen = new FormData()
      formDataImagen.append('id', personal[0].id)
      formDataImagen.append('imagen', image)

      await fetch('http://localhost:4000/api/personal/subir-imagen', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formDataImagen
      })
      .then(res => res.json())
      .then(data => {
        if (!data.error) {
          cargarFoto(data.body.imagen)
          document.getElementById('perfil-menu').src = 'http://localhost:4000/' + data.body.imagen
        }
      })
      .catch(err => {
        console.error('Error:', err)
      })
    }

    try {
      const res = await fetch(`http://localhost:4000/api/personal/editarDatosPersonales`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(body)
      })

      const data = await res.json()

      if (!res.ok) {
        ModalConfirmacion(`Error: ${data.body || 'No se pudo actualizar los datos'}`)
        return
      }

      // Volver a obtener datos actualizados y actualizar vista
      personal = await obtenerProfesor()
      document.getElementById('nombre').textContent = `${personal[0].nombre} ${personal[0].apellido}`
      document.getElementById('ocupacion').textContent = personal[0].ocupacion

      // Limpiar y volver a crear sección de datos personales
      const datosPers = document.getElementById('datosPersonales')
      datosPers.innerHTML = `<h2 class="text-xl font-bold text-blue-700 mb-4 border-b border-gray-200 pb-2">Datos personales</h2>`
      agregarHTML(personal[0])

      ModalConfirmacion('Datos personales actualizados correctamente')
      div.remove()
    } catch (error) {
      console.error(error)
    }
  }
})

}

async function cargarFoto(imagen = personal[0].imagen) {
  document.getElementById('imagen-perfil').src = 'http://localhost:4000/' + imagen
}

function ModalConfirmacion(mensaje = 'Operación realizada correctamente') {
  const modalExistente = document.getElementById('modal-confirmacion')
  if (modalExistente) modalExistente.remove()

  const modal = document.createElement('DIV')
  modal.id = 'modal-confirmacion'
  modal.innerHTML = `
    <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50">
      <div class="bg-white p-6 rounded-xl w-full max-w-md shadow-lg space-y-4 relative text-center">
        <h2 class="text-lg font-semibold text-gray-800">${mensaje}</h2>
        <button id="cerrarConfirmacion" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded transition-all duration-200">Aceptar</button>
      </div>
    </div>
  `
  document.body.appendChild(modal)

  document.getElementById('cerrarConfirmacion').addEventListener('click', () => {
    modal.remove()
  })
}
</script>
