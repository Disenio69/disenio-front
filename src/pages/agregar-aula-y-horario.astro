---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title='Agregar un aula y horario' path='Agregar un aula y horario' pageTitle='Agregar un aula y horario'>
    <form id="form-classroom-schedule" class="w-full pl-16 pr-16 mt-6">
        <div class="w-full md:w-1/3 ml-6 pr-8 mb-6 input">
            <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="classroom">
            Seleccionar aula
            </label>
            <select class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="select-classroom" name="classroom">
                <option value="" disabled selected>-- Selecciona una opción --</option>
                <option id="select-option" value="classroom 1">Aula 1</option>
                <option id="select-option" value="classroom 2">Aula 2</option>
                <option id="select-option" value="classroom 3">Aula 3</option>
                <option id="select-option" value="classroom 4">Aula 4</option>
                <option id="select-option" value="classroom 5">Aula 5</option>
                <option id="select-option" value="classroom 6">Aula 6</option>
                <option id="select-option" value="classroom 7">Aula 7</option>
                <option id="select-option" value="classroom 8">Aula 8</option>
                <option id="select-option" value="classroom 9">Aula 9</option>
                <option id="select-option" value="classroom 10">Aula 10</option>
                <option id="select-option" value="classroom 11">Aula 11</option>
                <option id="select-option" value="classroom 12">Aula 12</option>
            </select>
        </div>
        <div class="flex flex-wrap mx-3 mb-6">
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="day">
                    Dia
                </label>
                <select class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="select-day" name="day">
                    <option value="" disabled selected>-- Selecciona una opción --</option>
                    <option id="select-option" value="monday">Lunes</option>
                    <option id="select-option" value="tuesday">Martes</option>
                    <option id="select-option" value="wednesday">Miercoles</option>
                    <option id="select-option" value="thursday">Jueves</option>
                    <option id="select-option" value="friday">Viernes</option>
                </select>
            </div>
            <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-schedule-start">
                Horario inicio
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-schedule-start" type="time">
            </div>
                <div class="w-full md:w-1/3 px-3 mb-6">
                <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for="input-schedule-end">
                Horario fin
                </label>
                <input class="appearance-none block w-full bg-gray-200 text-gray-700 rounded py-3 px-4 mb-3 leading-tight focus:outline-none" id="input-schedule-end" type="time">
            </div>
            
        </div>
        <div class="flex items-center ml-6">
            <button id="form-classroom-schedule" class="bg-blue-500 hover:bg-blue-700 focus:outline-none focus:shadow-outline text-white font-bold py-2 px-4 rounded " type="submit">
              Agregar usuario
            </button>
            <a class="bg-white text-black font-bold px-4 hover:border-b-2 border-b-black cursor-pointer ml-20" href="/gestion-aulas-y-horarios">
                Cancelar
              </a>
          </div>
      </form>
</DashboardLayout>

